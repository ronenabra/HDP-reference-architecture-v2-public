<% const basePath = typeof browserBase === 'string' ? browserBase : ''; %>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= serviceName %> Logs
    </title>
    <link rel="stylesheet" href="<%= basePath %>/assets/connectathon.css">
    <script defer src="<%= basePath %>/assets/connectathon.js"></script>
    <script defer src="<%= basePath %>/assets/log-clipboard.js"></script>
    <style>
        body {
            height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .header {
            flex: 0 0 auto;
            padding: 10px 20px;
            border-bottom: 1px solid #ddd;
            background: #f8f9fa;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        .header h5,
        .header > .d-flex {
            min-width: 0;
        }

        .header h5 {
            overflow-wrap: anywhere;
        }

        .header > .d-flex {
            flex-wrap: wrap;
        }

        @media (max-width: 767.98px) {
            .header > .d-flex {
                width: 100%;
                gap: 0.5rem !important;
            }
        }

        .content {
            flex: 1 1 auto;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        .log-list {
            flex: 1 1 50%;
            overflow: auto;
            border-bottom: 1px solid #ddd;
        }

        .log-details-pane {
            flex: 1 1 50%;
            overflow-y: auto;
            padding: 20px;
            background: #fdfdfd;
        }

        .log-entry {
            font-family: monospace;
            border-bottom: 1px solid #eee;
            padding: 5px 10px;
            cursor: pointer;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .log-entry:hover {
            background-color: #f1f1f1;
        }

        .log-entry.selected {
            background-color: #e9ecef;
            border-left: 4px solid #0d6efd;
        }

        pre {
            background: #f8f9fa;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 4px;
        }
        [hidden] { display: none !important; }
        .local-logs-page { min-height: 0; flex: 1; display: flex; flex-direction: column; }
        .local-logs-page > .sandbox-header { padding-inline: 16px; }
        .local-toolbar .local-pause { margin-left: auto; }
        .sandbox-heading h1 { font-size: 24px; margin: 8px 0 0; }
        .local-toolbar, .local-tools { padding: 8px 16px; display: flex; align-items: center; flex-wrap: wrap; gap: 8px; background: #fff; border-bottom: 1px solid #d8e0eb; }
        .local-toolbar .btn, .local-tools .btn, .local-pause { min-height: 44px; display: inline-flex; align-items: center; gap: 8px; font-size: 14px; }
        .local-tools p { flex-basis: 100%; margin: 0; font-size: 14px; }
        .local-tools textarea { width: 100%; max-height: 80px; }
        .log-entry { min-height: 44px; font-size: 14px; text-align: left; background: #fff; color: #182b46; border: 0; border-bottom: 1px solid #d8e0eb; }
        .log-entry:focus-visible, .btn:focus-visible { outline: 3px solid #1f6feb; outline-offset: -3px; }
        .log-details-pane { min-height: 0; overflow: auto; }
        .log-details-pane pre { white-space: pre-wrap; overflow-wrap: anywhere; }
        .log-details-pane p { overflow-wrap: anywhere; }
    </style>
    <script>
        let isPaused = false;
        let selectedId = null;

        let records = new Map();
        let refreshing = false;

        /** Render full stored values as text, including payloads containing markup. */
        function selectLog(id) {
            selectedId = id;
            document.querySelectorAll('.log-entry').forEach(el => el.classList.toggle('selected', el.dataset.logId === id));
            const log = records.get(id);
            if (!log) return;
            const pane = document.getElementById('details-pane');
            const heading = document.createElement('h4');
            heading.dataset.helpKey = 'logs.details';
            heading.textContent = 'Selected event';
            const summary = document.createElement('p');
            summary.dataset.helpKey = 'logs.message';
            summary.textContent = `${log.level} · ${log.timestamp} · ${log.message} · ID: ${id}`;
            const payload = document.createElement('pre');
            payload.dataset.helpKey = 'logs.payload';
            payload.textContent = JSON.stringify(log.details, null, 2);
            pane.replaceChildren(heading, summary, payload);
            document.getElementById('copy-local').disabled = false;
        }

        /** Refresh with explicit missing/empty/error state and preserve selection by ID. */
        async function refreshLogs() {
            if (isPaused || refreshing) return;
            refreshing = true;
            const status = document.getElementById('local-log-status');
            try {
                const response = await fetch(`${document.body.dataset.browserBase || ''}/api/logs`);
                if (!response.ok) throw new Error(`Log read failed (HTTP ${response.status})`);
                const logs = await response.json();
                if (!Array.isArray(logs)) throw new Error('Malformed log response');
                status.textContent = response.headers.get('X-Log-State') === 'missing' ? `No ${document.body.dataset.serviceName} log file has been created.`
                    : logs.length ? `${logs.length} recorded events` : `${document.body.dataset.serviceName} log file is empty.`;
                const list = document.getElementById('log-list');
                const currentScroll = list.scrollTop;
                records = new Map(logs.map(log => [String(log.id), log]));
                const rows = logs.map(log => {
                    const entry = document.createElement('button');
                    entry.type = 'button';
                    entry.className = `log-entry w-100 text-start ${selectedId === String(log.id) ? 'selected' : ''}`;
                    entry.dataset.helpKey = 'logs.row';
                    entry.dataset.logId = String(log.id);
                    entry.textContent = `${log.level} · ${log.timestamp} · ${log.message}`;
                    entry.addEventListener('click', () => selectLog(String(log.id)));
                    return entry;
                });
                list.replaceChildren(...rows);
                list.scrollTop = currentScroll;
                if (selectedId && records.has(selectedId)) selectLog(selectedId);
                else if (selectedId) {
                    selectedId = null;
                    document.getElementById('copy-local').disabled = true;
                    document.getElementById('details-pane').textContent = 'Selected event is no longer in the current log.';
                }
            } catch (error) {
                status.textContent = `${error.message}. Displaying the last successful result; retrying.`;
            } finally {
                refreshing = false;
            }
        }

        /** Local Tools is presentation only; opening it never reads or changes logs. */
        function closeLocalTools() {
            document.getElementById('local-tools').hidden = true;
            const trigger = document.getElementById('local-tools-button');
            trigger.setAttribute('aria-expanded', 'false'); trigger.focus();
        }
        /** Open the existing secondary section and focus its close action. */
        function toggleLocalTools() {
            const panel = document.getElementById('local-tools');
            if (!panel.hidden) return closeLocalTools();
            panel.hidden = false;
            document.getElementById('local-tools-button').setAttribute('aria-expanded', 'true');
            document.getElementById('close-local-tools').focus();
        }
        /** Share the existing truthful clipboard fallback without persisting event text. */
        function copyLocalRecord() {
            const id = selectedId;
            const record = records.get(id);
            if (!record) return;
            const manual = document.getElementById('local-copy-text');
            window.PCM_LOG_CLIPBOARD.create({ document, navigator,
                status: text => { document.getElementById('local-copy-status').textContent = text; },
                manual: text => { manual.hidden = text === null; manual.value = text || ''; }
            }).copy(JSON.stringify(record, null, 2), { current: () => selectedId === id });
        }
        document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && !event.defaultPrevented && document.getElementById('pcm-help-tooltip')?.hidden !== false && !document.getElementById('local-tools').hidden) {
                event.preventDefault(); closeLocalTools();
            }
        });
        setInterval(refreshLogs, 3000);
        window.onload = refreshLogs;
    </script>
<script defer src="<%= basePath %>/assets/help-copy.js"></script><script defer src="<%= basePath %>/assets/help.js"></script></head>

<body data-service-name="<%= serviceName %>" data-browser-base="<%= basePath %>" data-help-team="<%= typeof teamId !== "undefined" ? teamId : "local" %>">
    <main class="local-logs-page" aria-labelledby="local-logs-title">
    <header class="sandbox-header">
        <div class="sandbox-heading"><span class="badge bg-dark" data-help-key="common.team"><%= teamId %></span>
            <h1 id="local-logs-title" data-help-key="service-logs.page"><%= serviceName %> Logs</h1></div>
        <nav class="sandbox-navigation" aria-label="Sandbox pages">
            <a class="btn btn-outline-secondary" href="<%= publicUrls.spClient %>" data-help-key="common.nav-doctor">Doctor</a>
            <a class="btn btn-outline-secondary" href="<%= publicUrls.pcmUi %>/ui" data-help-key="common.nav-consents">Consents</a>
            <a class="btn btn-outline-secondary" href="<%= publicUrls.pcmUi %>/admin/services" data-help-key="services.nav">Services</a>
            <a class="btn btn-outline-secondary" href="<%= publicUrls.pcmUi %>/admin" data-help-key="common.nav-admin">Admin</a>
            <a class="btn btn-outline-secondary" href="<%= basePath %>/logs-view" aria-current="page" data-help-key="service-logs.page">Local logs</a>
            <label class="explain-toggle" data-help-key="common.explain"><input type="checkbox"> Explain this page</label>
        </nav>
    </header>
    <nav class="local-toolbar" aria-label="Service event controls">
        <span data-help-key="service-logs.page">This service only</span>
        <a class="btn" href="<%= publicUrls.pcmUi %>/logs-view?role=fhir" data-help-key="service-logs.central">Open central Logs</a>
        <label class="local-pause"><input type="checkbox" data-help-key="service-logs.pause" id="pauseSwitch" onchange="isPaused = this.checked"> Pause updates</label>
        <button type="button" class="btn" onclick="refreshLogs()" data-help-key="service-logs.refresh">Refresh</button>
        <button type="button" id="local-tools-button" class="btn" aria-controls="local-tools" aria-expanded="false" onclick="toggleLocalTools()" data-help-key="service-logs.tools">Tools</button>
    </nav>
    <section id="local-tools" class="local-tools" aria-label="Local log tools" hidden>
        <button type="button" id="close-local-tools" class="btn" onclick="closeLocalTools()" data-help-key="service-logs.close-tools">Close tools</button>
        <button type="button" id="copy-local" class="btn" onclick="copyLocalRecord()" data-help-key="service-logs.copy" disabled>Copy selected JSON</button>
        <p>Full export, source coverage and built-in clear are available in central Logs Tools. Local events do not establish a complete cross-service trace.</p>
        <p id="local-copy-status" role="status"></p>
        <textarea id="local-copy-text" aria-label="Manual copy text" data-help-key="service-logs.copy" readonly hidden></textarea>
    </section>
    <p data-help-key="logs.empty" id="local-log-status" class="small m-2" role="status">Loading service logs…</p>
    <div class="content">
        <div data-help-key="service-logs.page" id="log-list" class="log-list" role="region" aria-label="Legacy service event log" tabindex="0">
            <div class="p-3 text-muted">Loading logs...</div>
        </div>
        <div data-help-key="logs.details" id="details-pane" class="log-details-pane" role="region" aria-label="Selected log details" tabindex="0">
            <div class="text-muted text-center mt-5">Select a log entry to view details</div>
        </div>
    </div>
    </main>
</body>

</html>
