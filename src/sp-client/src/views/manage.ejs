<% const basePath = typeof browserBase === 'string' ? browserBase : ''; const rejected = typeof draft !== 'undefined' ? draft : null; %>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Manage organization · Doctor</title>
    <link rel="stylesheet" href="<%= basePath %>/assets/connectathon.css">
    <script defer src="<%= basePath %>/assets/connectathon.js"></script>
<script defer src="<%= basePath %>/assets/help-copy.js"></script><script defer src="<%= basePath %>/assets/help.js"></script></head>

<body data-browser-base="<%= basePath %>" class="container aux-page" data-help-team="<%= typeof teamId !== "undefined" ? teamId : "local" %>">
    <header class="header sandbox-header mb-3">
        <div class="sandbox-heading">
            <h1 data-help-key="doctor.manage"><span class="badge bg-dark" data-help-key="common.team"><%= teamId %></span> Manage organization</h1>
            <p>Requesting application: <strong><%= identities.find(item => item.id === identity)?.label || identity %></strong></p>
        </div>
        <nav class="sandbox-navigation" aria-label="Sandbox pages">
            <a href="<%= basePath %>/?identity=<%= encodeURIComponent(identity) %>" aria-current="page" class="btn btn-outline-secondary" data-help-key="common.nav-doctor">Doctor</a>
            <a href="<%= publicBaseUrls.pcmUi %>/ui" class="btn btn-outline-secondary" data-help-key="common.nav-consents">Consents</a>
            <a href="<%= publicBaseUrls.pcmUi %>/logs-view" class="btn btn-outline-secondary" data-help-key="common.nav-logs">Logs</a>
            <label class="explain-toggle" data-help-key="common.explain"><input type="checkbox"> Explain this page</label>
        </nav>
    </header>
    <div class="aux-toolbar mb-3">
        <form action="<%= basePath %>/manage" method="GET" class="aux-toolbar">
            <label for="manage-identity" data-help-key="doctor.manage-identity">Requesting application</label>
            <select id="manage-identity" name="identity" data-help-options="all" class="form-select" onchange="this.form.submit()" data-help-key="doctor.manage-identity">
                <% identities.forEach(function(item) { %><option data-help-key="<%= item.helpKey || 'doctor.identity-registered' %>" value="<%= item.id %>" <%= item.id === identity ? 'selected' : '' %>><%= item.label %></option><% }); %>
            </select>
        </form>
        <a href="<%= basePath %>/?identity=<%= encodeURIComponent(identity) %>" class="btn btn-outline-secondary" data-help-key="common.nav-doctor">Back to Doctor</a>
    </div>
    <main>
    <% if (flash) { %>
        <div
            role="<%= flash.type === 'error' ? 'alert' : 'status' %>" id="manage-feedback" class="alert alert-<%= flash.type === 'error' ? 'danger' : (flash.type === 'success' ? 'success' : 'info') %>" data-help-key="common.feedback">
            <%= flash.message %>
        </div>
        <% } %>

            <% if (!orgs || orgs.length===0) { %>
                <div class="alert alert-warning" data-help-key="doctor.organization-empty">No organization records returned for this application. Check access and registration.</div>
                <% } else { %>

                    <h2 data-help-key="doctor.organizations" class="mb-3">Visible organizations (<%= orgs.length %>)</h2>
                    <% orgs.forEach(function(org, index) { %>
                        <!-- Organization Editor -->
                        <div class="card mb-4">
                            <div class="card-header aux-toolbar">
                                <span>Organization: <strong>
                                        <%= org.name %>
                                    </strong> (ID: <%= org.id %>)</span>
                                <span data-help-key="doctor.organization-type" class="badge bg-light text-dark">
                                    <%= org.type?.[0]?.coding?.[0]?.code || 'Organization' %>
                                </span>
                            </div>
                            <div class="card-body">
                                <form action="<%= basePath %>/manage/org" method="POST">
                                    <input type="hidden" name="identity" value="<%= identity %>">
                                    <input type="hidden" name="id" value="<%= org.id %>">

                                    <div class="mb-3">
                                        <label class="form-label" for="organization-json-<%= index %>">Organization JSON (unsaved inspection text)</label>
                                        <textarea id="organization-json-<%= index %>" aria-describedby="organization-hint-<%= index %>" data-help-key="doctor.organization-json" aria-label="Organization JSON definition" name="jsonContent" class="form-control font-monospace"
                                            rows="10"><%= JSON.stringify(org, null, 4) %></textarea>
                                        <p class="form-text" id="organization-hint-<%= index %>">Typing here does not save the organization. This page has no organization save action; PCM controls protected fields.</p>
                                    </div>
                                </form>
                            </div>
                        </div>
                        <% }); %>

                            <!-- Endpoints Editor -->
                            <h2 data-help-key="doctor.endpoints" class="mb-3">Associated endpoints (<%= endpoints.length %>)</h2>
                            <% if (endpoints.length===0) { %>
                                <div class="alert alert-info" data-help-key="common.feedback">No endpoints linked to this organization directly.</div>
                                <% } %>

                                    <% endpoints.forEach(function(ep, index) { %>
                                        <div data-help-key="doctor.endpoint-card" class="card mb-3">
                                            <div
                                                class="card-header aux-toolbar">
                                                <span>Endpoint: <strong>
                                                        <%= ep.name || ep.address %>
                                                    </strong> (ID: <%= ep.id %>)</span>
                                                <span data-help-key="doctor.endpoint-card" class="badge bg-light text-dark">
                                                    <%= ep.status %>
                                                </span>
                                            </div>
                                            <div class="card-body">
                                                <form action="<%= basePath %>/manage/endpoint" method="POST">
                                                    <input type="hidden" name="identity" value="<%= identity %>">
                                                    <input type="hidden" name="id" value="<%= ep.id %>">

                                                    <div class="mb-3">
                                                        <label class="form-label" for="endpoint-json-<%= index %>">Endpoint JSON</label>
                                                    <textarea id="endpoint-json-<%= index %>" <%- rejected?.kind === 'endpoint' && rejected.id === ep.id ? 'aria-invalid="true" aria-describedby="manage-feedback"' : '' %> data-help-key="doctor.endpoint-json" aria-label="Endpoint JSON definition" name="jsonContent" class="form-control font-monospace"
                                                            rows="6"><%= rejected?.kind === 'endpoint' && rejected.id === ep.id ? rejected.jsonContent : JSON.stringify(ep, null, 4) %></textarea>
                                                    </div>

                                                    <button type="submit" class="btn btn-secondary" data-help-key="doctor.endpoint-update">Update endpoint</button>
                                                </form>
                                            </div>
                                        </div>
                                        <% }); %>

                                            <% } %>

            <% if (rejected?.kind === 'endpoint' && (!orgs.length || !endpoints.some(ep => ep.id === rejected.id))) { %>
                <section class="card mb-4" aria-labelledby="endpoint-recovery-title">
                    <div class="card-header"><h2 id="endpoint-recovery-title">Rejected endpoint draft</h2></div>
                    <div class="card-body">
                        <p>The current record is unavailable. This draft was not saved. Correct it and retry when the record is available.</p>
                        <p>Endpoint ID: <code><%= rejected.id %></code></p>
                        <form action="<%= basePath %>/manage/endpoint" method="POST">
                            <input type="hidden" name="identity" value="<%= identity %>">
                            <input type="hidden" name="id" value="<%= rejected.id %>">
                            <label class="form-label" for="endpoint-json-recovery">Endpoint JSON</label>
                            <textarea id="endpoint-json-recovery" name="jsonContent" class="form-control font-monospace mb-3" rows="6" aria-invalid="true" aria-describedby="manage-feedback" data-help-key="doctor.endpoint-json"><%= rejected.jsonContent %></textarea>
                            <button type="submit" class="btn btn-secondary" data-help-key="doctor.endpoint-update">Update endpoint</button>
                        </form>
                    </div>
                </section>
            <% } %>

            <div class="card border-info mt-4 mb-4">
                <div class="card-header bg-info text-dark" data-help-key="doctor.catalog-section">Request a non-material catalog update</div>
                <div class="card-body">
                    <form action="<%= basePath %>/manage/catalog-update" method="POST">
                        <input type="hidden" name="identity" value="<%= identity %>">
                        <label class="form-label" for="catalog-json">Complete authoritative catalog JSON</label>
                        <textarea id="catalog-json" data-help-key="doctor.catalog-json" aria-label="Catalog JSON definition" name="jsonContent" class="form-control font-monospace" rows="8" required <%- rejected?.kind === 'catalog' ? 'aria-invalid="true" aria-describedby="manage-feedback"' : '' %>><%= rejected?.kind === 'catalog' ? rejected.jsonContent : '' %></textarea>
                        <label class="form-label mt-2" for="catalog-update-reason" data-help-key="doctor.catalog-reason">Reason (optional)</label>
                        <input id="catalog-update-reason" name="reason" value="<%= rejected?.kind === 'catalog' ? rejected.reason || '' : '' %>" class="form-control" data-help-key="doctor.catalog-reason">
                        <div class="form-text mb-2">Only name, purpose, and example-query changes are eligible; acceptance does not mutate the live catalog.</div>
                        <button type="submit" class="btn btn-info" data-help-key="doctor.catalog-submit">Submit request</button>
                    </form>
                </div>
            </div>

    </main>
</body>

</html>
