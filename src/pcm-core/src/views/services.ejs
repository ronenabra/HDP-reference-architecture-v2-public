<% const basePath = typeof browserBase === 'string' ? browserBase : ''; const selectedView = typeof locals.selectedView === 'string' ? locals.selectedView : 'catalog'; const doctorRole = typeof locals.doctorProviderRole === 'string' ? locals.doctorProviderRole : ''; const doctorQuery = doctorRole ? '&providerRole=' + encodeURIComponent(doctorRole) : ''; const catalog = locals.catalog; const catalogError = locals.catalogError || ''; const unitLabel = (value, code) => Number(value) === 1 ? (units[code] || code).replace(/s$/, '') : (units[code] || code); %>
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Services · Consent administration</title><link rel="stylesheet" href="<%= basePath %>/assets/connectathon.css">
<script defer src="<%= basePath %>/assets/connectathon.js"></script><script defer src="<%= basePath %>/assets/services-lifecycle.js"></script><script defer src="<%= basePath %>/assets/services.js"></script>
<script defer src="<%= basePath %>/assets/help-copy.js"></script><script defer src="<%= basePath %>/assets/help.js"></script></head>
<body data-browser-base="<%= basePath %>" class="container services-page" data-help-team="<%= teamId %>"><main>
<header class="sandbox-header"><div class="sandbox-heading"><h1 data-help-key="services.page"><span class="badge bg-dark" data-help-key="common.team"><%= teamId %></span> Services</h1></div>
<nav class="sandbox-navigation" aria-label="Sandbox pages"><% if (typeof doctorReturnUrl === 'string') { %><a href="<%= doctorReturnUrl %>" data-services-fragment="doctor-return" data-help-key="doctor.services-return">Doctor</a><% } %><a href="<%= basePath %>/ui" data-help-key="common.nav-consents">Consents</a><a href="<%= basePath %>/admin/services<%= doctorRole ? '?providerRole=' + encodeURIComponent(doctorRole) : '' %>" aria-current="page" data-help-key="services.page">Services</a><a href="<%= basePath %>/admin" data-help-key="common.nav-admin">Admin</a><a href="<%= basePath %>/logs-view" data-help-key="common.nav-logs">Logs</a><label class="explain-toggle" data-help-key="common.explain"><input type="checkbox"> Explain this page</label></nav></header>
<section class="card mb-3 services-create" data-service-panel hidden aria-labelledby="service-create-heading">
<div class="card-body"><div class="services-toolbar"><h2 id="service-create-heading" tabindex="-1">New service</h2><button type="button" class="btn btn-secondary" data-service-cancel data-help-key="services.new">Back / Cancel</button></div>
<p data-help-key="services.create">Create a shared definition first. Approval and provider connection are separate actions; this form connects no providers.</p>
<p role="status" data-template-draft data-help-key="services.templates"></p>
<form data-service-create action="<%= basePath %>/admin/services/catalog" data-provider-role="<%= role %>" data-csrf="<%= formCsrf %>" data-preview-csrf="<%= ownerCsrf('', 'catalog-preview') %>" data-catalog-csrf="<%= typeof catalogCreation !== 'undefined' ? catalogCreation.creation.csrf : '' %>" data-revision="<%= typeof catalogCreation !== 'undefined' ? catalogCreation.revision : '' %>">
    <fieldset class="services-group"><legend data-help-key="services.templates">Starting point</legend>
    <div class="services-starting-points"><button type="button" class="btn" data-service-blank aria-pressed="true" data-help-key="services.templates">Blank</button>
    <% templates.forEach(template => { %><button type="button" class="btn" data-service-template-pick data-template-key="<%= template.key %>" data-template-values="<%= JSON.stringify({ ...template.definition, exampleQueries: template.exampleQueries }) %>" data-template-description="<%= template.summary %> <%= template.dataDescription %>" data-help-key="services.template-add" aria-pressed="false"><strong><%= template.definition.name %></strong><span><%= template.definition.purpose %></span></button><% }); %></div>
    <% if (!templates.length) { %><p>Templates unavailable. New service remains available.</p><% } %>
    <p data-template-summary>Blank — enter service details and data access below. Selecting a starting point creates nothing.</p></fieldset>
    <fieldset class="services-group"><legend>Service details</legend>
    <label class="form-label" for="service-name" data-help-key="services.name">Service name</label><input id="service-name" name="name" class="form-control mb-2" required maxlength="2000" data-help-key="services.name">
    <label class="form-label" for="service-purpose" data-help-key="services.purpose">Purpose</label><textarea id="service-purpose" name="purpose" class="form-control mb-2" required maxlength="2000" data-help-key="services.purpose"></textarea>
    <details><summary data-help-key="services.category" data-help-proxy>Service classification and type</summary><p data-help-key="services.category">Fixed service classification: Hospital (35). Fixed information-access type: INFA (information access). This administrative category is separate from the information categories below.</p><input type="hidden" name="category" value="35"></details>
    <label class="form-label" for="service-access-mode" data-help-key="services.mode">Access mode</label><select id="service-access-mode" name="accessMode" class="form-select mb-2" data-help-key="services.mode"><option value="continuous">Ongoing access during the approval period</option><option value="one-time">One hour per client and source, starting with first use</option></select>
    <div class="row"><div class="col-md-6"><label for="service-duration" data-help-key="services.duration">Maximum consent period</label><input id="service-duration" name="duration" type="number" min="1" max="1000" value="6" required class="form-control" data-help-key="services.duration"></div>
    <div class="col-md-6"><label for="service-duration-unit" data-help-key="services.duration">Consent period unit</label><select id="service-duration-unit" name="durationUnit" class="form-select" data-help-key="services.duration"><% Object.entries(units).forEach(([code, label]) => { %><option value="<%= code %>" <%= code === 'mo' ? 'selected' : '' %>><%= label %></option><% }); %></select></div></div>
    <label class="form-check mt-2" data-help-key="services.patient-changes"><input name="allowChanges" type="checkbox" class="form-check-input" data-help-key="services.patient-changes"> Let patients choose data categories</label><p data-help-key="services.patient-changes">This records a service preference. The current Consent screen has no separate category editor.</p>
    </fieldset><fieldset class="services-group"><legend data-help-key="services.permissions">Data access</legend>
    <section class="services-scope-mode" data-scope-mode data-mode="generated" aria-labelledby="service-scope-mode-heading" data-help-key="services.scope-mode">
        <p class="services-mode-label" data-scope-mode-label>Generated from settings</p>
        <h3 id="service-scope-mode-heading" class="h6" data-scope-mode-heading>The settings below determine access</h3>
        <p data-scope-mode-description>Changing generator settings updates the final scope. Review its exact text before saving.</p>
        <dl class="services-scope-facts" data-scope-facts></dl>
        <button type="button" class="btn btn-primary" data-switch-scopes aria-controls="service-scope-replacement" aria-expanded="false" hidden>Switch to settings-generated scope…</button>
    </section>
    <section class="services-scope-replacement" id="service-scope-replacement" data-scope-replacement hidden aria-labelledby="service-scope-replacement-heading">
        <h3 id="service-scope-replacement-heading" class="h6" tabindex="-1">Review before replacing the manual scope</h3>
        <p>This replaces the entire scope using the settings below. It can change more than the Restricted (R) rule.</p>
        <p data-scope-comparison-note></p>
        <table class="services-scope-comparison"><caption class="visually-hidden">Permissions after switching to Generated mode</caption><thead data-scope-comparison-head></thead><tbody data-scope-comparison></tbody></table>
        <p>Longer scope text spells out more rules; it does not necessarily mean broader access.</p>
        <div class="services-toolbar"><button type="button" class="btn btn-primary" data-confirm-scopes>Use settings and replace scope</button><button type="button" class="btn btn-secondary" data-keep-manual>Keep manual scope</button></div>
    </section>
    <details data-generator-settings open><summary data-generator-label>Generator settings — active</summary>
    <p id="service-generator-explanation" data-generator-explanation>These settings generate the final scope below.</p>
    <fieldset class="services-generator-controls" data-service-generator aria-describedby="service-generator-explanation"><legend class="visually-hidden">Scope generator settings</legend>
    <% Object.entries(bucketResources).forEach(([code, resources]) => { %>
    <fieldset class="card p-2 mb-2" data-service-bucket="<%= code %>" data-types="<%= JSON.stringify(Object.keys(resources)) %>"><legend class="h6"><label data-help-key="services.data-category"><input type="checkbox" name="enabled"> <%= categoryLabels[code] || code %></label></legend>
        <div data-bucket-settings hidden><div class="row"><div class="col-md-6"><label for="history-<%= code %>" data-help-key="services.history">Include records from the past</label><input id="history-<%= code %>" name="history" type="number" min="0" max="1000" value="2" class="form-control" data-help-key="services.history"></div>
        <div class="col-md-6"><label for="history-unit-<%= code %>" data-help-key="services.history">History unit</label><select id="history-unit-<%= code %>" name="historyUnit" class="form-select" data-help-key="services.history"><% Object.entries(units).forEach(([unit, label]) => { %><option value="<%= unit %>"><%= label %></option><% }); %></select></div></div>
        <details><summary data-help-key="services.sensitivity">Additional sensitive categories allowed (default: none)</summary>
        <% sensitivityLabels.forEach(tag => { %><label class="form-check" data-help-key="services.sensitivity"><input class="form-check-input" type="checkbox" name="sensitivity" value="<%= tag.system %>|<%= tag.code %>"> <span><%= ({ HIV: 'Human immunodeficiency virus (HIV)', PHY: 'Physician-requested sensitivity', PRS: 'Patient-requested sensitivity', NOPAT: 'Patient/family disclosure needs provider approval' })[tag.code] || tag.code.replaceAll('-', ' ') %></span> <code>(<%= tag.system %> | <%= tag.code %>)</code></label><% }); %></details></div>
    </fieldset><% }); %>
    <label class="form-check mt-2" data-help-key="services.master-data" data-help-proxy><input name="includeMasterData" type="checkbox" class="form-check-input" checked> Include master data — read only</label>
    <p data-help-key="services.master-data">Organization, Practitioner, PractitionerRole and Location by known logical ID. No search, history, writes or included results.</p>
    <label class="form-check" data-help-key="services.confidentiality" data-help-proxy><input type="checkbox" name="allowRestricted" class="form-check-input"> Include Restricted (R) records deliberately</label><p data-restricted-impact>Restricted (R) and Very Restricted (V) records are excluded, including Patient. Sensitive categories do not change this policy.</p>
    <div data-permission-types data-help-key="services.actions"></div>
    </fieldset></details>
    </fieldset><fieldset class="services-group"><legend>Review</legend>
    <section aria-labelledby="service-saved-heading"><h3 id="service-saved-heading" class="h6">Permission review</h3>
    <p data-help-key="services.scope" data-scope-origin role="status" aria-live="polite">Generated</p>
    <label for="service-custom-scope" data-help-key="services.advanced">Final service scope</label><textarea id="service-custom-scope" name="approvalScope" rows="7" maxlength="16384" required readonly class="form-control scope-value" data-help-key="services.advanced" aria-describedby="service-preview-status service-replacement-note"></textarea>
    <p id="service-replacement-note" data-scope-edit-note>Read-only preview of the active settings. Choose Edit exact scope manually to write your own scope.</p>
    <button type="button" class="btn btn-secondary" data-edit-scopes data-help-key="services.advanced">Edit exact scope manually</button>
    <button type="button" class="btn btn-secondary" data-reset-scopes data-help-key="services.reset-scopes">Regenerate from settings</button>
    <button type="button" class="btn btn-secondary" data-copy-scope data-help-key="services.copy-scope">Copy final service scope</button>
    <p data-help-key="services.preview" role="status" aria-live="polite" id="service-preview-status" data-preview-status></p><p data-help-key="services.preview" data-preview-policy></p>
    <p data-scope-interpretation></p>
    <p data-help-key="services.scope">Approval freezes one exact scope; different permissions require a new Consent. Saving this default grants no access.</p>
    <p data-help-key="services.preview" data-generated-history>Generated history uses a fixed creation-time cutoff; newer records stay eligible. Zero starts at creation, not unlimited history.</p></section>
    <details><summary data-help-key="services.rules">Generator inputs</summary><pre class="scope-value" data-service-rules></pre></details>
    <details><summary data-help-key="services.template-examples">Illustrative query metadata</summary><label for="service-examples" data-help-key="services.template-examples">Example queries (JSON array of resource type and query text)</label><textarea id="service-examples" name="exampleQueries" rows="5" maxlength="32768" class="form-control scope-value" data-help-key="services.template-examples"></textarea><p>Text only, never executed. Leave blank to generate examples from the selected actions. Each entry uses type and query; use selected resource types once.</p></details>
    <p role="status" aria-live="polite" data-service-result data-help-key="services.result" id="service-create-result"></p>
    <% if (privateActionsUnavailable) { %><p data-help-key="services.disabled">Private catalog creation is unavailable in Strict. This draft remains editable.</p><% } %>
    <button class="btn btn-primary" <%= privateActionsUnavailable ? 'disabled' : '' %> data-help-key="services.create" data-help-disabled-key="services.result" data-help-proxy>Create service</button>
</fieldset></form></div></section>

<div data-service-browse>
<div class="services-toolbar">
<form method="get" action="<%= basePath %>/admin/services" data-service-load><% if (doctorRole) { %><input type="hidden" name="providerRole" value="<%= doctorRole %>"><% } %><button class="btn btn-secondary" data-help-key="services.load">Refresh</button></form>
<button type="button" class="btn btn-primary" data-service-new data-help-key="services.new" data-help-proxy>New service</button></div>
<nav class="services-peer-views" aria-label="Services views" data-services-fragment="views">
<a href="<%= basePath %>/admin/services?view=catalog<%= doctorQuery %>" data-service-peer="catalog" data-help-key="services.catalog" <%- selectedView === 'catalog' ? 'aria-current="page"' : '' %>>Service catalog</a>
<a href="<%= basePath %>/admin/services?view=assignments<%= doctorQuery %>" data-service-peer="assignments" data-help-key="services.list" <%- selectedView === 'assignments' ? 'aria-current="page"' : '' %>>Provider assignments</a>
</nav>
<section data-services-fragment="catalog" <%= selectedView !== 'catalog' ? 'hidden' : '' %> aria-labelledby="catalog-heading">
<h2 id="catalog-heading" tabindex="-1">Service catalog</h2>
<p data-help-key="services.catalog">Shared service definitions. Manage provider connections in Provider assignments; Consent approval remains separate.</p>
<% if (catalogError) { %><p role="alert"><%= catalogError %> Refresh from the first page; existing results are unavailable.</p><% } else if (catalog) { %>
<p data-catalog-boundary><%= catalog.items.length %> of <%= catalog.total %> definitions on this page. <%= catalog.complete ? 'Complete snapshot.' : 'Other pages may contain additional definitions.' %></p>
<table class="services-catalog-table"><caption class="visually-hidden">Shared service definitions — Admin inventory</caption><thead><tr><th scope="col">Service</th><th scope="col">Data access</th><th scope="col">Catalog status</th><th scope="col">Actions</th></tr></thead>
<% catalog.items.forEach(row => { const admin = row.admin; const blocked = admin.reason || admin.actionReasons[row.next] || (row.next && !admin.actions.includes(row.next) ? 'This state cannot be restored by Admin.' : ''); %>
<tbody data-catalog-id="<%= row.id %>" data-catalog-version="<%= row.version %>"><tr>
<th scope="row" data-label="Service"><strong><%= row.name %></strong> <% if (row.builtin) { %><small class="services-text-badge">Built-in</small><% } %><p><%= row.resource.extraDetails || 'Purpose not recorded.' %></p><small><%= row.registrationCount %> provider registrations, including history</small></th>
<td data-label="Data access"><p><%= row.access %></p><small>Access still requires an eligible Consent, provider and source.</small></td>
<td data-label="Catalog status"><strong><%= row.stateLabel %></strong><p><%= row.availability %></p></td>
<td data-label="Actions"><span class="services-text-badge" data-help-key="services.admin-provenance" tabindex="0">Admin</span><p>Global actions affect all providers of this definition.</p>
<form data-service-sandbox action="<%= basePath %>/admin/services/<%= row.id %>/sandbox" data-service-name="<%= row.name %>" data-target-kind="catalog" data-version="<%= row.version %>" data-csrf="<%= admin.csrf %>">
<% if (row.next) { %><button type="submit" name="action" value="<%= row.next %>" class="btn btn-secondary" data-help-key="services.<%= row.next %>" data-help-proxy data-help-context="<%= blocked %>" <%= admin.actions.includes(row.next) ? '' : 'disabled' %>><%= row.nextLabel %></button><% } %>
<% if (blocked) { %><p data-help-key="services.disabled"><%= blocked %></p><% } %>
<details data-catalog-overflow="<%= row.id %>"><summary data-help-key="services.delete">Admin actions</summary><p>Permanently remove this inactive, unreferenced runtime definition. No undo, cascade or seed rewrite.</p><p data-help-key="services.dependencies"><%= admin.deleteReason || admin.reason || 'No deletion blockers recorded.' %></p><% if (admin.dependencies.registrations.length) { %><a href="<%= basePath %>/admin/services?view=assignments&amp;target=<%= row.id %><%= doctorQuery %>" data-help-key="services.target">View provider assignments</a><% } %>
<% if (Object.entries(admin.dependencies).some(([, value]) => Array.isArray(value) && value.length)) { %><ul><% Object.entries(admin.dependencies).forEach(([kind, values]) => { if (Array.isArray(values) && values.length) { %><li><%= kind %>: <%= values.join(', ') %></li><% } }); %></ul><% } %>
<button type="submit" name="action" value="delete" class="btn btn-outline-danger" data-help-key="services.delete" data-help-proxy data-help-context="<%= admin.deleteReason || admin.reason %>" <%= admin.actions.includes('delete') ? '' : 'disabled' %>>Delete definition</button></details>
<p data-service-result data-help-key="services.result" role="status" aria-live="polite"></p></form>
</td></tr><tr class="services-detail-row"><td colspan="4"><details data-service-expansion="<%= row.id %>" data-version="<%= row.version %>"><summary data-help-key="services.catalog-details">Details</summary><div class="services-catalog-details">
<h3><%= row.name %> — definition details</h3><p class="scope-value">HealthcareService/<%= row.id %> · version <%= row.version %></p>
<p>Maximum consent period: <%= row.period %></p><p>Public FHIR facts: persisted HealthcareService. This Admin read does not imply visibility through ordinary provider discovery.</p>
<p><span class="services-text-badge">Admin</span> Private authoring source: <%= row.definitionSource %> · <%= row.definition.status %>.</p>
<% if (row.definition.status === 'ok') { const grant = row.definition.grant; %><p>Scope origin: <%= grant.origin === 'custom' ? 'Manual override' : 'Generated' %>. Saved creation/history anchor: <%= grant.anchor %>. History mode: <%= grant.historyMode %>.</p><p>Saved service default; existing Consent approvals retain their exact immutable permissions.</p><% if (grant.scope === 'patient/*.rs') { %><p data-help-key="services.full-access">All supported patient data · read/search. Includes Restricted (R) and Very Restricted (V), with no category, sensitivity or history predicates. Patient/source context still applies. Organization, Practitioner, PractitionerRole and Location require separate explicit direct-read grants.</p><% } %><details><summary data-help-key="services.scope">Exact saved service scope</summary><pre class="scope-value" data-saved-scope><%= grant.scope %></pre></details><% } %>
<details><summary data-help-key="services.technical">Exact public FHIR facts</summary><pre class="scope-value"><%= JSON.stringify(row.resource, null, 2) %></pre></details>
<details><summary data-help-key="services.catalog-details">Exact private authoring facts · Admin</summary><pre class="scope-value"><%= JSON.stringify(row.definition, null, 2) %></pre></details>
</div></details></td></tr></tbody><% }); %></table>
<% if (!catalog.items.length) { %><p>No shared service definitions on this page. New service creates a definition without connecting providers.</p><% } %>
<% if (catalog.nextOffset !== null) { %><a data-catalog-next data-help-key="services.paging" href="<%= basePath %>/admin/services?view=catalog&amp;offset=<%= catalog.nextOffset %>&amp;revision=<%= catalog.revision %><%= doctorQuery %>">Next catalog page</a><% } %>
<% if (catalog.offset) { %><a data-help-key="services.paging" href="<%= basePath %>/admin/services?view=catalog<%= doctorQuery %>">First catalog page</a><% } %><% } %>
</section>
<p data-services-loading data-help-key="services.load" role="status" hidden>Loading Services…</p>
<div data-services-fragment="notices" <%= selectedView !== 'assignments' ? 'hidden' : '' %>>
<p data-help-key="services.visibility"><span class="services-text-badge">Admin</span> Protected provider inventory. Ordinary actions use each row's exact provider credentials; browsing obtains no provider token.</p>
<% if (warnings.length) { %><details class="services-notices"><summary data-help-key="services.visibility">Result notices (<%= warnings.length %>): some information is unavailable</summary><% warnings.forEach(warning => { %><p><%= warning %></p><% }); %></details><% } %>
</div>
<section <%= selectedView !== 'assignments' ? 'hidden' : '' %> class="services-list" data-services-fragment="list" aria-labelledby="services-view-heading">
<h2 tabindex="-1" id="services-view-heading" data-help-key="services.list">Provider assignments</h2>
<% if (catalogError) { %><p role="alert"><%= catalogError %> Provider connections are unknown. Refresh from the first page.</p><% } else if (catalog) { %>
<p data-help-key="services.paging"><%= catalog.items.length %> of <%= catalog.total %> services on this page. <%= catalog.complete ? 'Complete service snapshot.' : 'Partial service snapshot — other pages are not loaded.' %></p>
<div class="services-filters"><label data-help-key="services.filter">Provider <select class="form-select" data-provider-filter aria-label="Filter loaded assignments by provider"><option value="">All providers</option><% const shownProviders = new Map(); (locals.groups || []).forEach(group => group.providers?.items.forEach(provider => shownProviders.set(provider.id, provider))); [...shownProviders.values()].sort((a,b) => a.id.localeCompare(b.id)).forEach(provider => { %><option value="<%= provider.id %>"><%= provider.name || provider.id %> · <%= provider.id %></option><% }); %></select></label><label data-help-key="services.filter">Service name <input type="search" class="form-control" data-service-filter aria-label="Filter loaded services by name"></label><label data-help-key="services.filter">Catalog status <select class="form-select" data-service-status aria-label="Filter loaded services by status"><option value="">All statuses</option><% ['pending','active','suspended','frozen','rejected','cancelled','unknown'].forEach(state => { %><option value="<%= state %>"><%= state %></option><% }); %></select></label></div>
<p role="status" data-service-count></p><p data-service-no-match hidden>No matching assignments in the loaded pages. Other provider or service pages may contain matches; refresh or use the page links to inspect them.</p>
<% (locals.groups || []).forEach(group => { const service = group.service; const page = group.providers; const pageQuery = catalog.offset ? '&offset=' + catalog.offset + '&revision=' + catalog.revision : ''; %>
<section class="services-provider-group" data-service-group="<%= service.id %>" data-service-name="<%= service.name %>" data-service-state="<%= service.state %>" aria-labelledby="group-<%= service.id %>">
<h3 id="group-<%= service.id %>" tabindex="-1"><%= service.name %> <% if (service.builtin) { %><small class="services-text-badge">Built-in</small><% } %></h3><% if (service.definition?.grant?.scope === 'patient/*.rs') { %><p data-help-key="services.full-access">All supported patient data · read/search. Includes Restricted (R) and Very Restricted (V). Exact scope: <code>patient/*.rs</code>.</p><% } %><p data-group-result role="status" aria-live="polite"></p>
<p>Catalog: <strong><%= service.stateLabel %></strong>. <%= service.registrationCount %> provider registrations, including history.</p>
<p><a href="<%= basePath %>/admin/services?view=catalog&amp;target=<%= service.id %><%= doctorQuery %>" data-help-key="services.target">Review catalog definition</a> · <span class="scope-value">HealthcareService/<%= service.id %></span></p>
<% if (group.error || !page) { %><p role="alert" data-group-unavailable>Provider connections unknown: <%= group.error || 'Provider inventory unavailable.' %> No disconnection is inferred. Refresh this service group.</p>
<% } else { %>
<p data-provider-completeness data-help-key="services.paging"><%= page.items.length %> of <%= page.total %> providers on this group page. <%= page.complete ? 'Complete provider snapshot.' : 'Partial provider snapshot — unloaded pairs are unknown, never Not connected.' %></p>
<% if (!service.registrationCount) { %><p data-zero-registrations>No providers connected to this service. Choose an eligible provider below.</p><% } %>
<p data-provider-no-match hidden>No assignment rows for this provider in this group’s loaded page. Use the provider page links below to inspect other pages.</p>
<table class="services-directory-table"><caption class="visually-hidden">Provider connections for <%= service.name %></caption><thead><tr><th scope="col" data-help-key="services.provider">Provider</th><th scope="col" data-help-key="services.status">Saved assignment state</th><th scope="col">Actions</th></tr></thead>
<% page.items.forEach(provider => { const rows = provider.registrations.length ? provider.registrations : [null]; rows.forEach(registration => { const state = registration?.state; const label = ({ pending: 'Pending — waiting for activation', active: 'Connected', suspended: 'Paused', frozen: 'Frozen', rejected: 'Rejected', cancelled: 'Ended' })[state] || (registration ? 'Unknown' : provider.standardManagement ? 'Not connected' : 'Unavailable — no stored registration'); const admin = registration?.admin; %>
<tbody data-provider-pair="<%= provider.id %>" <%- registration ? 'data-service-id="' + registration.id + '"' : '' %>><tr>
<th scope="row" data-label="Provider"><strong><%= provider.name || provider.id %></strong><p class="scope-value">Organization/<%= provider.id %></p><small>Inventory source: <%= provider.source %> · Admin</small></th>
<td data-label="Saved assignment state"><strong><%= label %></strong><% if (registration) { %><p class="scope-value">HealthcareService/<%= registration.id %> · version <%= registration.version %></p><% } %>
<% const block = provider.unavailableReason || (registration ? (state === 'pending' ? 'Activate this assignment to allow use.' : state === 'suspended' ? 'Resume this assignment to allow use.' : state === 'active' && service.state !== 'active' ? 'The shared definition is ' + service.stateLabel + '. Review its catalog state before use.' : state === 'active' && registration.availability?.startsWith('Not usable:') ? registration.availability + ' Ask the administrator to resolve this saved configuration.' : ['frozen','rejected','cancelled'].includes(state) ? ({ frozen: 'This assignment is frozen. Ask the administrator to review the restriction.', rejected: 'This request was rejected. Review the catalog before making a new connection request.', cancelled: 'This assignment ended. Connect again to make a new request; old approvals remain terminal.' })[state] : '') : provider.connect.reason); if (block) { %><p data-help-key="services.disabled"><%= block %></p><% } %><small>Saved configuration only; no live network health check. Consent and source checks still apply.</small></td>
<td data-label="Actions"><div class="services-provider-actions">
<% if (!registration || state === 'cancelled' && registration === rows.at(-1)) { %>
<form data-service-assign action="<%= basePath %>/admin/services/assign" data-provider-id="<%= provider.id %>" data-provider-role="<%= provider.credentialRole || '' %>" data-csrf="<%= provider.connect.csrf %>"><input type="hidden" name="catalogId" value="<%= service.id %>"><button class="btn btn-primary" data-help-key="services.assign" data-help-context="<%= provider.connect.reason %>" <%= provider.connect.available ? '' : 'disabled' %>>Connect</button><p data-service-result role="status" aria-live="polite"></p></form>
<% } %>
<% if (registration && ['pending','active','suspended'].includes(state)) { %>
<form data-service-status-form data-registration-id="<%= registration.id %>" data-provider-id="<%= provider.id %>" data-catalog-id="<%= service.id %>" action="<%= basePath %>/admin/services/<%= registration.id %>/status" data-provider-role="<%= provider.credentialRole || '' %>" data-csrf="<%= registration.standard.csrf %>" data-version="<%= registration.version %>" data-state="<%= state %>" data-service-name="<%= service.name %>" data-provider-name="<%= provider.name || provider.id %>">
<% for (const [next, text] of state === 'pending' ? [['cancelled','Withdraw request']] : state === 'active' ? [['suspended','Pause'],['disconnect','Disconnect']] : [['active','Resume'],['disconnect','Disconnect']]) { %><button class="btn <%= text === 'Disconnect' ? 'btn-outline-danger' : 'btn-secondary' %>" name="state" value="<%= next %>" data-help-key="services.lifecycle" data-help-context="<%= provider.unavailableReason || '' %>" <%= registration.standard.actions.includes(next === 'disconnect' ? (state === 'active' ? 'suspended' : 'cancelled') : next) ? '' : 'disabled' %>><%= text %></button><% } %>
<p><%= state === 'active' ? 'Disconnect is terminal; reconnect creates a new request. Pause and End are checked separately and are not atomic.' : state === 'pending' ? 'Activation is a separate Admin decision; withdrawing this request is terminal.' : 'Disconnect is terminal; reconnect creates a new request. Old approvals stay terminal.' %></p><p data-service-result role="status" aria-live="polite"></p></form><% } %>
<% if (registration) { const next = ({ pending: 'activate', active: 'disable', suspended: 'enable' })[state]; %>
<details class="services-admin-actions"><summary data-help-key="services.admin-provenance">Admin actions</summary><form data-service-sandbox action="<%= basePath %>/admin/services/<%= registration.id %>/sandbox" data-service-name="<%= service.name %>" data-target-kind="instance" data-provider-name="<%= provider.name || provider.id %>" data-version="<%= registration.version %>" data-csrf="<%= admin.csrf %>">
<% if (next) { const reason = admin.reason || admin.actionReasons[next] || ''; %><button class="btn btn-secondary" name="action" value="<%= next %>" data-help-key="services.<%= next %>" data-help-context="<%= reason %>" <%= admin.actions.includes(next) ? '' : 'disabled' %>><%= ({ activate: 'Activate', disable: 'Disable', enable: 'Enable' })[next] %></button><% if (reason) { %><p><%= reason %></p><% } %><% } %>
<div><p>Permanently remove this inactive registration; no undo or cascade.</p><p><%= admin.deleteReason || admin.reason || 'Remove only this inactive, unreferenced registration. No cascade.' %></p><button class="btn btn-outline-danger" name="action" value="delete" data-help-key="services.delete" data-help-context="<%= admin.deleteReason || admin.reason %>" <%= admin.actions.includes('delete') ? '' : 'disabled' %>>Delete registration</button></div><p data-service-result role="status" aria-live="polite"></p></form></details><% } %>
<p data-connection-result role="status" aria-live="polite"></p></div></td></tr><tr class="services-directory-detail"><td colspan="3"><details data-service-expansion="<%= registration?.id || service.id + ':' + provider.id %>" data-version="<%= registration?.version || provider.version %>"><summary data-help-key="services.row">Details</summary><h4><%= service.name %> — <%= provider.name || provider.id %></h4><% const preference = provider.defaults?.services?.[service.id]; if (service.builtin) { %><p data-help-key="services.full-access">Default enrollment: <%= preference?.initialized ? 'initialized' : 'not initialized' %>. Retained individual choice: <%= preference?.override || 'none recorded' %>. Global enable preserves this choice.</p><% } %><p>Protected persisted FHIR inventory · Admin. Ordinary requests use this provider's own credentials. Catalog approval, registration activation and Patient Consent are separate.</p><% if (service.builtin) { %><details><summary data-help-key="services.technical">Exact registration and provider facts</summary><% } %><pre class="scope-value"><%= JSON.stringify({ service: service.id, provider: { defaults: provider.defaults, id: provider.id, source: provider.source, registered: provider.registered, operational: provider.operational, standardCapabilityState: provider.standardCapabilityState }, registrationsComplete: provider.registrationsComplete, connection: provider.connection, registration: registration?.resource || null }, null, 2) %></pre><% if (service.builtin) { %></details><% } %></details></td></tr></tbody>
<% }); }); %></table>
<% if (!page.items.length) { %><p>No provider rows returned on this page. <%= page.complete ? 'The registered provider inventory is empty.' : 'Other provider pages remain unknown.' %></p><% } %>
<% if (page.nextOffset !== null) { %><a data-provider-next data-help-key="services.paging" href="<%= basePath %>/admin/services?view=assignments&amp;target=<%= service.id %><%= pageQuery %>&amp;group=<%= service.id %>&amp;providerOffset=<%= page.nextOffset %>&amp;providerRevision=<%= page.revision %><%= doctorQuery %>">Next providers for <%= service.name %></a><% } %>
<% if (page.offset) { %><a data-help-key="services.paging" href="<%= basePath %>/admin/services?view=assignments&amp;target=<%= service.id %><%= pageQuery %><%= doctorQuery %>">First providers for <%= service.name %></a><% } %><% } %>
</section><% }); %>
<% if (!catalog.items.length) { %><p>No shared service definitions. Create a service before connecting providers.</p><% } %>
<% if (catalog.nextOffset !== null) { %><a data-service-next data-help-key="services.paging" href="<%= basePath %>/admin/services?view=assignments&amp;offset=<%= catalog.nextOffset %>&amp;revision=<%= catalog.revision %><%= doctorQuery %>">Next services page</a><% } %>
<a class="services-refresh" data-help-key="services.load" href="<%= basePath %>/admin/services?view=assignments<%= doctorQuery %>">Refresh from first page</a><% } %>
</section>

<p data-help-key="services.effect">Clinical permissions and Patient/source context are enforced in every security preset. Successful access does not prove real patient or Ministry approval.</p>
<p data-help-key="services.restart">Uncheckpointed runtime changes are lost on restart/reset. An explicit retained checkpoint can preserve services and registrations. This screen never changes seed files or deletes patient data.</p>
</div></main></body></html>
