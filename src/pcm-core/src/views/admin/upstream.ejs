<form method="post" action="<%= basePath %>/admin/config/security"><input type="hidden" name="adminForm" value="legacy-upstream"><input type="hidden" name="expectedRevision" value="<%= Number(config.runtime.revision) || 0 %>">          <label class="form-label" for="ds-gateway-fhir-url" data-help-key="admin.upstream-url">Legacy source custom upstream FHIR server URL</label>
          <input class="form-control mb-2" id="ds-gateway-fhir-url" name="dsGatewayToFhirServerCustomUrl" value="<%- escapeHtml(draft('/admin/config/security', 'dsGatewayToFhirServerCustomUrl', dsGatewaySecurity.customUrl || '')) %>" placeholder="http://host.docker.internal:8088/fhir" data-help-key="admin.upstream-url">
          <div class="form-text mb-2">Optional, legacy-ds only. Managed source gateways always retain their own HAPI targets. Clearing this restores the legacy built-in FHIR server.</div>
          <%- dsGatewaySecurity.customUrl && dsGatewaySecurity.customUrlScope !== 'legacy-ds' ? '<label class="form-check mb-2"><input class="form-check-input" type="checkbox" name="acknowledgeLegacyUpstream" value="true" required data-help-key="admin.upstream-url"> I reviewed migration from all-gateway routing to legacy-ds only; preserve this URL for legacy.</label>' : '' %>
<button class="btn btn-primary" data-help-key="admin.upstream-url">Save legacy upstream</button></form>