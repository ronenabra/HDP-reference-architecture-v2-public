<% if (sanityView) { %>
<button type="button" class="btn btn-outline-secondary" data-admin-toggle="admin-sanity-result" aria-expanded="true" aria-controls="admin-sanity-result" data-help-key="admin.sanity-result">Show / hide last result</button>
<section id="admin-sanity-result" class="alert alert-<%= sanityView.status === 'pass' ? 'success' : sanityView.status === 'fail' ? 'danger' : 'warning' %>" aria-label="Last sanity check">
<div class="admin-toolbar"><h3><%= sanityView.title %></h3><button type="button" class="btn btn-outline-secondary" data-admin-dismiss="admin-sanity-result" data-help-key="admin.sanity-dismiss">Dismiss result</button></div>
<% if (options.sanityResult.timedOut || !sanityView.rows.length) { %><p role="alert"><%= options.sanityResult.timedOut ? 'The runner timed out. Its checks may be incomplete; inspect diagnostics before retrying.' : 'The runner did not return individual checks. Review technical details and diagnostics.' %></p><% } %>
<details open><summary data-help-key="common.details">Check results</summary><table class="table admin-addresses"><thead><tr><th scope="col">Check</th><th scope="col">Result</th><th scope="col">Detail</th></tr></thead><tbody><% sanityView.rows.forEach(row => { %><tr><td data-label="Check"><code><%= row.name %></code></td><td data-label="Result"><%= row.status %></td><td data-label="Detail"><%= row.detail %></td></tr><% }) %></tbody></table><% if (!sanityView.rows.length) { %><p>No individual checks were recorded.</p><% } %></details>
<h4>Next step</h4><p><%= sanityView.next %></p><a href="<%= basePath %>/logs-view?diagnostics=true&amp;source=pcm-core" data-help-key="admin.operation-logs">Open PCM diagnostics</a><p class="small">Sanity runner events use operation <code>sanity-check</code>.</p>
<details><summary data-help-key="common.details">Technical details</summary><pre><%= JSON.stringify(options.sanityResult, null, 2) %></pre></details></section><% } %>
