<% if (req.query?.sourceInstitution === 'saved') { %><p role="status" class="alert alert-success" data-help-key="admin.source-institution-save">Institution type saved.</p><% } %>
<% if (workspace.view === 'registration') { %>
<dl><dt>Source ID</dt><dd><code data-help-key="admin.source-id"><%= source.id %></code></dd><dt>FHIR base URL</dt><dd><code data-help-key="admin.source-endpoint"><%= source.endpoint %></code></dd><dt>Client ID</dt><dd><code data-help-key="admin.source-client-id"><%= source.clientId %></code></dd></dl>
<form method="post" action="<%= basePath %>/admin/config/data-sources/<%= encodeURIComponent(source.id) %>/institution" data-source-institution-form>
<input type="hidden" name="expectedRevision" value="<%= Number(config.runtime.revision) || 0 %>"><label for="managed-institution" data-help-key="admin.source-institution">Institution type</label><select id="managed-institution" data-help-key="admin.source-institution" name="institutionType" class="form-select"><% for (const [value,label] of [['hmo','HMO'],['hospital','Hospital'],['other','Other']]) { %><option value="<%= value %>" <%= draft(`/admin/config/data-sources/${source.id}/institution`,'institutionType',source.institutionType) === value ? 'selected' : '' %>><%= label %></option><% } %></select><button class="btn btn-outline-primary" data-help-key="admin.source-institution-save">Save institution type</button></form>
<p>The team operator manages this built-in source’s identity and address.</p>
<% } else if (workspace.view === 'trust') { const verification = require('../../../shared/conformance-policy').sourceSimulationControls(policy,config,{clientId:source.clientId}).serverCertificateVerification !== false; %>
<p>How outgoing connections verify this source’s HTTPS server.</p><p class="alert alert-<%= verification ? 'info' : 'warning' %>" data-help-key="simulation.serverCertificateVerification">Server verification is <strong><%= verification ? 'on' : 'off' %></strong> in the current settings. <%= verification ? 'Saved trust applies to future connections; readiness is not checked.' : 'The saved CA and fingerprint are not checked while verification is off.' %> <a data-help-key="admin.area-security" href="<%= shell.address(basePath,'security',source.id) %>">Review Security &amp; access</a></p>
<dl><dt>Saved trust method</dt><dd data-help-key="admin.source-trust"><%= ({'team-root-ca':'Team CA','system-ca':'System CAs','custom-ca':'Custom CA','pinned-thumbprint':'Team CA and server fingerprint','insecure-skip-verify':'Skip verification'})[source.serverTrust?.mode] || source.serverTrust?.mode || 'Team CA' %></dd><dt>Server fingerprint</dt><dd><code data-help-key="admin.source-server-thumbprint"><%= source.serverTrust?.certThumbprint || 'No additional pin configured' %></code></dd><dt>Certificate management</dt><dd>Managed by the team operator</dd></dl>
<details><summary data-help-key="common.details">Certificate reference</summary><code><%= source.serverTrust?.caCert || config.certificates.rootCaCert %></code></details>
<% } else { %>
<p>Credentials this source uses to authenticate to PCM.</p><dl><dt>Client ID</dt><dd><code><%= source.clientId %></code></dd><dt>Certificate profile</dt><dd><%= source.pcmClientAuth?.mtlsCert ? 'Separate transport and assertion credentials' : 'Shared transport and assertion certificate' %></dd><dt>Uses</dt><dd>mTLS client authentication and signed client assertions</dd></dl>
<% require('../source-credentials').credentialFacts(process.env.CERTS_DIR || config.runtime.certsDir, source).forEach(fact => { %><p data-help-key="admin.source-client-thumbprint"><strong><%= fact.role %></strong> · Valid <%= fact.validFrom %> to <%= fact.validTo %></p><details><summary data-help-key="common.details">Fingerprint</summary><code><%= fact.fingerprint %></code></details><% }); %>
<details><summary data-help-key="common.details">How to change managed credentials</summary><p>Use the controlled certificate preview/apply workflow on the operator host, then check connections with fresh tokens. Replacing listener credentials requires restarting this team.</p></details>
<% } %>
