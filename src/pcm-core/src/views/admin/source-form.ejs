<% const existing = typeof source !== 'undefined' && source;
const mode = typeof formView === 'string' ? formView : 'onboarding';
const action = !existing ? '/admin/config/data-sources/add' : mode === 'registration' ? `/admin/config/data-sources/${source.id}/institution` : mode === 'credentials' ? `/admin/config/data-sources/${source.id}/cert/generate` : `/admin/config/data-sources/${source.id}/server-trust/ca`;
// Trust has two supported commands; recover only the exact selected source's failed command.
const draftAction = existing && mode === 'trust' && req.path === `/admin/config/data-sources/${source.id}/server-trust/thumbprint` ? req.path : action;
const val = (key, fallback = '') => draft(draftAction, key, fallback);
const revision = Number(config.runtime.revision) || 0;
%>
<% if (!existing) { %><h3 data-help-key="admin.source-add">Add custom source</h3><p>Unsaved draft. Files and credentials publish only after Save. Runtime readiness remains not checked.</p><% } %>
<% if (!existing || mode === 'registration' || existing.available) { %>
<form method="post" enctype="multipart/form-data" action="<%= basePath + action %>" class="row g-3" data-source-command data-source-pin-action="<%= existing ? basePath + `/admin/config/data-sources/${source.id}/server-trust/thumbprint` : '' %>" data-source-ca-action="<%= basePath + action %>" data-source-current="<%= JSON.stringify(existing ? {name:source.name,endpoint:source.endpoint,institutionType:source.institutionType,serverTrustMode:source.serverTrust?.mode,credential:'Current registered credentials'} : {}) %>">
<input type="hidden" name="expectedRevision" value="<%= revision %>">
<% if (existing) { %><input type="hidden" name="adminForm" value="<%= mode === 'registration' ? 'source-registration' : mode === 'trust' ? 'source-trust' : 'source-credentials' %>"><% } %>
<% if (!existing || mode === 'registration') { %>
<div class="col-md-6"><label for="source-name" class="form-label" data-help-key="admin.source-name">Source name</label><input id="source-name" class="form-control" name="name" required maxlength="240" value="<%= val('name',existing ? source.name : '') %>" data-help-key="admin.source-name"></div>
<div class="col-md-6"><label for="source-institution" class="form-label" data-help-key="admin.source-institution">Institution type</label><select id="source-institution" name="institutionType" class="form-select" data-help-key="admin.source-institution"><% [['other','Other'],['hmo','HMO'],['hospital','Hospital']].forEach(([value,label]) => { %><option value="<%= value %>" <%= val('institutionType',existing ? source.institutionType : 'other') === value ? 'selected' : '' %>><%= label %></option><% }); %></select></div>
<div class="col-12"><label for="source-endpoint" class="form-label" data-help-key="admin.source-endpoint">HTTPS FHIR base</label><input id="source-endpoint" class="form-control" type="url" name="endpoint" required value="<%= val('endpoint',existing ? source.endpoint : '') %>" placeholder="https://source.example.test/fhir" data-help-key="admin.source-endpoint"></div>
<% if (!existing) { %><div class="col-12"><label for="source-client-id" class="form-label" data-help-key="admin.source-client-id">Assigned opaque client ID</label><input id="source-client-id" class="form-control" name="clientId" value="<%= val('clientId') %>" placeholder="Leave blank to generate" data-help-key="admin.source-client-id"></div><% } else { %><p class="text-break">Client <code><%= source.clientId %></code> · Organization <code><%= source.id %></code>. These identities stay fixed.</p><% } %>
<% } %>
<% if (!existing || mode === 'credentials') { %>
<fieldset class="col-12 border rounded p-3 bg-white"><legend class="h5" data-help-key="admin.source-auth">PCM client credentials</legend>
<% if (existing) { %><p class="text-break">Client <code><%= source.clientId %></code>. Certificate facts describe saved material; authentication is not checked.</p>
<% require('../source-credentials').credentialFacts(process.env.CERTS_DIR || config.runtime.certsDir, source).forEach(fact => { %><p class="text-break" data-help-key="admin.source-client-thumbprint"><strong><%= fact.role %></strong> · SHA-256 <code><%= fact.fingerprint %></code><br>Valid from <%= fact.validFrom %> until <%= fact.validTo %></p><% }); } %>
<div class="row g-3"><div class="col-md-6"><label for="source-credential-mode" class="form-label" data-help-key="admin.source-credential-mode">Credential action</label><select id="source-credential-mode" name="credentialMode" class="form-select" data-help-key="admin.source-credential-mode"><% [['generate','Generate sandbox credentials'],['upload','Upload existing credentials']].forEach(([value,label])=> { %><option value="<%= value %>" <%= val('credentialMode',options.adminError ? 'upload' : 'generate') === value ? 'selected' : '' %>><%= label %></option><% }); %></select></div>
<div class="col-md-6"><label for="source-profile" class="form-label" data-help-key="admin.source-credential-profile">Credential profile</label><select id="source-profile" name="credentialProfile" class="form-select" data-help-key="admin.source-credential-profile"><% [['shared-es256','Shared P-256 / ES256'],['separate-es384','Separate P-384 / ES384']].forEach(([value,label])=> { %><option value="<%= value %>" <%= val('credentialProfile',existing && source.pcmClientAuth?.mtlsCert ? 'separate-es384' : 'shared-es256') === value ? 'selected' : '' %>><%= label %></option><% }); %></select></div>
<p data-help-key="admin.source-generate-demo" data-source-generate>Generate creates the chosen sandbox role pairs only when published.</p>
<p>Shared uses one P-256 pair for PCM transport and ES256 assertions. Separate uses an approved transport pair and a P-384 pair for ES384 assertions. Source HTTPS trust stays separate.</p>
<% for (const {name,label,kind,separate,helpKey} of [{name:'pcmClientAuthCertFile',label:'Assertion certificate',kind:'cert',separate:false,helpKey:'admin.source-client-cert'},{name:'pcmClientAuthKeyFile',label:'Assertion private key',kind:'key',separate:false,helpKey:'admin.source-client-key'},{name:'pcmTransportCertFile',label:'Transport certificate',kind:'cert',separate:true,helpKey:'admin.source-client-cert'},{name:'pcmTransportKeyFile',label:'Transport private key',kind:'key',separate:true,helpKey:'admin.source-client-key'}]) { %>
<div class="col-md-6" data-source-upload <%- separate ? 'data-source-separate' : '' %>><label class="form-label" for="<%= name %>" data-help-key="<%= helpKey %>"><%= label %></label><input id="<%= name %>" name="<%= name %>" type="file" accept="<%= kind === 'key' ? '.key,.pem' : '.crt,.pem' %>" class="form-control" data-help-key="<%= helpKey %>"></div><% } %>
</div></fieldset><% } %>
<% if (!existing || mode === 'trust') { %>
<fieldset class="col-12 border rounded p-3 bg-white" aria-describedby="source-trust-error"><legend class="h5" data-help-key="admin.source-trust">Source HTTPS trust</legend><% if (existing && mode === 'trust' && options.adminError) { %><p id="source-trust-error" class="alert alert-danger" role="alert"><%= options.adminError.message %> Correct the retained fields below and review again. Uploaded files must be selected again.</p><% } else { %><p id="source-trust-error" class="visually-hidden">Choose the trust method and its matching certificate or fingerprint.</p><% } %><p>Configures checks of the remote FHIR server. It does not change that server or authenticate the source to PCM.</p>
<% const verificationControl = (existing ? require('../../../shared/conformance-policy').sourceSimulationControls(policy,config,{clientId:source.clientId}) : policy.simulation.controls).serverCertificateVerification !== false; %>
<p data-source-verification-policy data-help-key="simulation.serverCertificateVerification">Current policy verification control: <strong><%= verificationControl ? 'On' : 'Off' %></strong>. <% if (!verificationControl) { %>Saved CA/pin settings are not checked while this control is off.<% } else { %>Future connections use the selected trust choice; readiness is not checked.<% } %> <a href="<%= shell.address(basePath,'security',existing ? source.id : '') %>">Review Security &amp; access</a>.</p>
<div class="row g-3"><div class="col-12"><label for="source-server-trust" class="form-label" data-help-key="admin.source-trust">Server verification</label><select id="source-server-trust" name="serverTrustMode" class="form-select" data-help-key="admin.source-trust"><% [['team-root-ca','Team CA'],['system-ca','System CAs'],['custom-ca','Custom CA'],['pinned-thumbprint','Team CA + server pin'],...(['connectathon-easy','connectathon-balanced'].includes(config.conformance.preset) ? [['insecure-skip-verify','Skip verification · sandbox relaxation']] : [])].forEach(([value,label]) => { %><option value="<%= value %>" <%= val('serverTrustMode',existing ? source.serverTrust?.mode : 'team-root-ca') === value ? 'selected' : '' %>><%= label %></option><% }); %></select></div>
<div class="col-md-6" data-source-trust="custom-ca"><label class="form-label" for="source-server-ca-path" data-help-key="admin.source-ca-path">Managed CA reference</label><input id="source-server-ca-path" class="form-control" name="serverTrustCaCert" value="<%= val('serverTrustCaCert',existing ? source.serverTrust?.caCert || '' : '') %>" placeholder="custom/source-ca.crt" data-help-key="admin.source-ca-path"></div>
<div class="col-md-6" data-source-trust="custom-ca"><label class="form-label" for="source-server-ca-upload" data-help-key="admin.source-ca-file">Or upload CA certificate</label><input id="source-server-ca-upload" name="serverTrustCaFile" type="file" accept=".crt,.pem" class="form-control" data-help-key="admin.source-ca-file"></div>
<div class="col-md-6" data-source-trust="pinned-thumbprint"><label class="form-label" for="source-server-thumbprint" data-help-key="admin.source-server-thumbprint">Server SHA-256 fingerprint</label><input id="source-server-thumbprint" name="serverTrustCertThumbprint" class="form-control" value="<%= val('serverTrustCertThumbprint',existing ? source.serverTrust?.certThumbprint || '' : '') %>" data-help-key="admin.source-server-thumbprint"></div>
<div class="col-md-6" data-source-trust="pinned-thumbprint"><label class="form-label" for="source-server-cert-upload" data-help-key="admin.source-server-cert">Or upload server certificate</label><input id="source-server-cert-upload" name="serverTrustCertFile" type="file" accept=".crt,.pem" class="form-control" data-help-key="admin.source-server-cert"></div>
<% if (!existing) { %><div class="col-12" data-source-trust="pinned-thumbprint"><label data-help-key="admin.source-reuse-pin"><input type="checkbox" name="reusePcmClientCertForServerTrust" value="true" data-help-key="admin.source-reuse-pin" <%= draftChecked(action,'reusePcmClientCertForServerTrust') ? 'checked' : '' %>> Use the PCM transport certificate as the server pin only when the source actually serves that same certificate.</label></div><% } %>
</div></fieldset><% } %>
<div class="col-12"><p>Saving changes only this registration. Existing authority and in-flight operations become stale when credentials, trust, availability or endpoint changes. Historical Consents and remote clinical data are retained. Runtime is not checked.</p>
<div data-source-review hidden tabindex="-1" role="status" aria-live="polite" class="alert alert-warning"><strong>Review exact changes</strong><pre class="text-break" data-source-changes></pre><p>Client and Organization identities remain fixed for an existing source. Publish applies these changes.</p></div>
<button class="btn btn-primary" data-source-save data-help-key="admin.source-save"><%= !existing ? 'Save source' : 'Save changes' %></button></div>
</form><% } %>
<% if (existing && mode === 'credentials' && source.available) { %><p>Explicit registration and credential exports include <strong>PRIVATE KEYS</strong>.</p><div class="admin-source-exports"><a class="btn btn-outline-secondary" href="<%= basePath %>/admin/config/data-sources/<%= source.id %>/client-bundle" data-help-key="admin.source-download">Download JSON · private keys</a> <a class="btn btn-outline-secondary" href="<%= basePath %>/admin/config/data-sources/<%= source.id %>/client-bundle.zip" data-help-key="admin.source-download">Download ZIP · private keys</a></div><% } %>
<% if (existing && mode === 'registration') { %>
<p>Disable prevents current use and invalidates existing authority. Re-enable uses the same identities and requires fresh authority. Remove registration requires disabled state; it retains historical references and never deletes remote data.</p>
<form method="post" action="<%= basePath %>/admin/config/data-sources/remove"><input type="hidden" name="expectedRevision" value="<%= revision %>"><input type="hidden" name="id" value="<%= source.id %>"><input type="hidden" name="action" value="<%= source.enabled === false ? 'enable' : 'disable' %>"><button class="btn btn-outline-secondary" data-help-key="admin.source-lifecycle"><%= source.enabled === false ? 'Re-enable source' : 'Disable source' %></button></form>
<form method="post" action="<%= basePath %>/admin/config/data-sources/remove" data-confirm="Remove this custom source?"><input type="hidden" name="expectedRevision" value="<%= revision %>"><input type="hidden" name="id" value="<%= source.id %>"><button class="btn btn-outline-danger" data-help-key="admin.source-remove">Remove source</button></form>
<% } %>
