<tr data-endpoint="<%= endpoint.key %>"><td data-label="Purpose"><strong data-help-key="<%= require('../deployment-help').deploymentHelpKey(endpoint) %>" data-help-context="<%= require('../deployment-help').deploymentContext(endpoint, 'service') %>"><%= endpoint.label %></strong><br><small><%= endpoint.audience === 'internal' ? 'Internal — not browser-routable' : ['spClient','pcmUi'].includes(endpoint.key) ? 'Browser application' : 'Protocol / API' %> · <%= endpoint.enabled ? 'Enabled' : 'Disabled' %></small></td><td data-label="Exact address"><code tabindex="0" data-exact-address data-help-key="admin.deployment-url"><%= endpoint.url %></code></td><td data-label="Actions"><div class="admin-endpoint-actions"><button type="button" class="btn btn-outline-secondary" data-copy-address data-help-key="admin.copy-address">Copy exact address</button><% if (endpoint.enabled && endpoint.diagnosticUrl) { %><a class="btn btn-outline-primary" data-help-key="admin.deployment-url" href="<%= endpoint.diagnosticUrl %>"><%= endpoint.diagnosticLabel.replace(' (client certificate when required)', '') %></a><% } %></div><span role="status" aria-live="polite" data-copy-status></span></td></tr>
