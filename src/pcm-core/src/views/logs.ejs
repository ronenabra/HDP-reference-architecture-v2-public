        /** Lazily mount only selected evidence and reuse existing stale-copy/manual fallback fences. */
        function mountSelectedFhir() {
            const host = document.getElementById('fhir-exchange-host');
            if (!host || host.childNodes.length || !selectedFhir || !selectedResult) return;
            const revision = detailRevision, id = selectedId;
            window.PCM_LOG_FHIR.mount(host, selectedFhir, {
                copy: value => logClipboard().copy(value, {
                    current: () => revision === detailRevision && selectedId === id && activeDetailTab === 'fhir' && host.isConnected,
                    success: 'Exact recorded FHIR evidence copied. Platform line endings may be normalized.'
