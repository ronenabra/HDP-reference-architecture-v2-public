            const message = document.getElementById('event-message');
            message.textContent = record ? formatLogMessage(record) : '';
            message.setAttribute('title', message.textContent);
        }
        /** A retained receipt/work record never establishes an unobserved HTTP or transaction outcome. */
        function nativeLifecycleNote(record) {
            if (record.event?.source?.role !== 'hapi') return '';
            const notes = {
                HAPI_REQUEST: 'Receipt observed. Completion is not established by this record. Without a retained matching terminal, completion was not observed and the outcome is unknown.',
                HAPI_ASYNC_TIMEOUT: 'Timeout observed. The outcome remains unknown until actual completion evidence is observed.',
                HAPI_NATIVE_WORK_FINISHED: 'Native work or cleanup finished. This does not establish response delivery, transaction commit or successful cancellation.'
            };
