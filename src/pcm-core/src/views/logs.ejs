        /** Apply only one exact filter, retaining the other effective filters and held/follow state. */
        function coverageFilter(field, value) {
            if (!['source', 'role', 'healthOrganizationId'].includes(field)) return;
            if (searchSession) {
                const filters = { ...searchSession.filters };
                if (value) filters[field] = value; else delete filters[field];
                const previousView = captureView(); saveCurrentView();
                const url = new URL(window.location.href);
                for (const name of [...FILTER_FIELDS, ...SEARCH_FIELDS]) {
                    if (filters[name]) url.searchParams.set(name, filters[name]); else url.searchParams.delete(name);
                }
                url.searchParams.delete('inspection'); investigation = null;
                pushView(`${url.pathname}${url.search}${url.hash}`);
                filterControl(field).value = value;
                return startSearch({ filters, previousView, preserveSelection: true });
            }
            // Coverage acts on effective URL filters, not unapplied edits in the form.
            loadFilters();
            filterControl(field).value = value;
            applyFilters(null, false, true);
