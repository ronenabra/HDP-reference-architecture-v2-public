        }
        /** Restore executable field controls after the history HTML is rehydrated. */
        function mountSelectedExplorer(state) {
            selectedExplorer = null;
            const host = document.getElementById('record-explorer-host');
            if (!window.PCM_LOG_RECORD || !host || !selectedRecord) return;
            const revision = detailRevision, id = selectedId;
            selectedExplorer = window.PCM_LOG_RECORD.mount(host, selectedRecordModel(selectedRecord, selectedResult || {}).record, {
                state, copy: (value, fieldCurrent) => logClipboard().copy(value, {
                    current: () => revision === detailRevision && selectedId === id && activeDetailTab === 'structured' && fieldCurrent(),
                    success: 'Complete field value copied. Platform line endings may be normalized.'
