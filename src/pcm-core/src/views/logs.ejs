            const scope = searchSession ? 'loaded search result page' : logPages.length > 1 ? 'loaded window' : 'loaded page';
            const labels = { 'newer-records': 'More newer retained events can be loaded.', 'older-records': 'More older retained events can be loaded.',
                'older-page': 'This response belongs to a captured snapshot; later appends are outside it.',
                'read-budget': 'Reading continues in bounded pages; this limit does not mean logging was lost.',
                'oversized-records': 'Oversized records were omitted from this view; use the authenticated full export.',
                'native-diagnostics-gaps': 'Native collection reports loss, stale health or an unavailable writer; missing records cannot establish completion.',
                'unreadable-streams': 'Some source streams could not supply evidence.', 'filtered-view': 'Active filters and event visibility limit the evidence shown.',
                'result-limit': 'The retained search match limit was reached. Narrow the query to inspect more evidence.', 'deadline': 'The retained search stopped at its deadline; results are incomplete.' };
            const reasons = currentCoverage?.reasons || [
                ...(result.nextCursor ? ['older-records'] : []), ...(pageCursor ? ['older-page'] : []),
                ...(result.skippedLongLines ? ['oversized-records'] : []), ...(result.failures?.length ? ['unreadable-streams'] : [])
