        <textarea id="column-id-value" data-help-key="logs.column-id" readonly></textarea>
        <p id="column-id-status" role="status" aria-live="polite"></p>
        <button type="button" class="btn" data-help-key="logs.column-id-copy" onclick="copyColumnId()">Copy complete ID</button>
        <button id="column-id-select" type="button" class="btn" data-help-key="logs.column-id-select" onclick="selectColumnId()">Select copy text</button>
        <button type="button" class="btn" data-help-key="logs.column-id-close" onclick="document.getElementById('column-id-dialog').close()">Close ID</button>
    </dialog>
    <div class="drawer-backdrop" id="drawer-backdrop" onclick="closeWorkbench()" hidden></div>
    </main>
    <script>
        const resizer = document.getElementById('resizer');
        const workspace = document.getElementById('log-workspace');
        let dragStartY = 0;
        let dragStartHeight = 0;
        let dragStartPercent = 48;
        let dragPointerId = null;
        let dragPointerType = null;
        /** One primary pointer owns a drag; cancellation restores the starting size. */
        resizer.addEventListener('pointerdown', event => {
            if (event.isPrimary === false || (event.pointerType !== 'touch' && event.button !== 0)) return;
            if (dragPointerId !== null) {
                // A fresh mouse/pen press means its previous active-buttons
                // sequence ended, even if that release never reached this page.
                // Never let a different pointer interrupt the current owner.
                if (event.pointerId !== dragPointerId || event.pointerType !== dragPointerType || !['mouse', 'pen'].includes(dragPointerType)) return;
                finishResize(event);
            }
            event.preventDefault(); holdReading();
            dragPointerId = event.pointerId; dragPointerType = event.pointerType; dragStartY = event.clientY;
            dragStartHeight = document.getElementById('event-detail').getBoundingClientRect().height;
            dragStartPercent = eventPanePercent;
            resizer.setPointerCapture(event.pointerId); resizer.classList.add('resizing');
            document.body.classList.add('resizing-event');
        });
        resizer.addEventListener('pointermove', event => {
            if (event.pointerId !== dragPointerId || recoverReleasedResize(event) || !resizer.hasPointerCapture(event.pointerId)) return;
            resizeEventPane((dragStartHeight + dragStartY - event.clientY) / Math.max(1, workspace.clientHeight) * 100, false);
        });
        function finishResize(event, cancelled = false) {
            if (event.pointerId !== dragPointerId) return;
            dragPointerId = null; dragPointerType = null;
            resizeEventPane(cancelled ? dragStartPercent : eventPanePercent, !cancelled);
            if (resizer.hasPointerCapture(event.pointerId)) resizer.releasePointerCapture(event.pointerId);
            resizer.classList.remove('resizing'); document.body.classList.remove('resizing-event');
        }
        /** Closing, opening a modal, and viewport changes safely abandon a drag. */
        function cancelEventResize() {
            if (dragPointerId !== null) finishResize({ pointerId: dragPointerId }, true);
        }
        /** A released mouse/pen returning to the page must not keep resizing.
         * The button bitmask also handles releasing the primary button while
         * another mouse button remains held (which need not emit pointerup).
         * Touch keeps its explicit up/cancel lifecycle and one-pointer owner.
         */
        function recoverReleasedResize(event) {
            if (event.pointerId !== dragPointerId || !['mouse', 'pen'].includes(dragPointerType) || !Number.isFinite(event.buttons) || (event.buttons & 1) !== 0) return false;
            finishResize(event);
            return true;
        }
        // Capture-phase completion survives a release targeted outside the
        // divider after capture is lost. These handlers remain owner-scoped.
        window.addEventListener('pointermove', recoverReleasedResize, true);
        window.addEventListener('pointerup', event => finishResize(event), true);
        window.addEventListener('pointercancel', event => finishResize(event, true), true);
        window.addEventListener('blur', cancelEventResize);
        resizer.addEventListener('pointerup', event => finishResize(event));
        resizer.addEventListener('pointercancel', event => finishResize(event, true));
        resizer.addEventListener('lostpointercapture', event => finishResize(event, true));
        resizer.addEventListener('keydown', event => {
            const current = Number(resizer.getAttribute('aria-valuenow'));
            const minimum = minimumEventPanePercent();
            const values = { ArrowUp: Math.min(70, current + 5), ArrowDown: Math.max(minimum, current - 5), Home: minimum, End: 70 };
            if (!(event.key in values)) return;
            event.preventDefault(); holdReading(); resizeEventPane(values[event.key]);
        });
    </script>
</body>

</html>
