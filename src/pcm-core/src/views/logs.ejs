        /** Identity and provenance stay visible beside either payload format. */
        function renderEventMetadata(selected, result = {}) {
            const { record, provenance, source, derived } = selectedRecordModel(selected, result);
            const metadataHelp = name => name === 'Level' ? window.PCM_HELP_VALUES.level(record.level)
                : name === 'Classification' ? window.PCM_HELP_VALUES.category(logCategory(record))
                : window.PCM_HELP_VALUES.metadata(name);
            const metadata = [
                ['Timestamp', record.timestamp], ['Level', record.level],
                ['Event ID', record.id || selected.id],
                ['Schema version', record.event?.schemaVersion || 'Legacy record (no event schema)'],
                ['Classification', formatLogClass(record)], ['Event name', record.event?.eventName || record.details?.type || 'Unspecified'],
                ['Source identity', sourceIdentity(record)], ['Source component ID', source.componentId || 'Unavailable'],
                ['Source file', source.logFile || 'Unavailable'], ['Source byte offset', source.byteOffset ?? 'Unavailable'],
                ['Provenance', provenance.kind || 'Unspecified'],
                ['Derived from', typeof provenance.derivedFrom === 'object' ? JSON.stringify(provenance.derivedFrom) : provenance.derivedFrom],
                ['Flow ID', getFlowId(record) || 'Not recorded'], ['Correlation / request ID', getCorrelationId(record) || 'Not recorded'], ['Trace ID', getTraceId(record) || 'Not recorded'],
                ['Span ID', record.event?.correlation?.spanId || record.details?.spanId || 'Not recorded'],
                ['Parent span ID', record.event?.correlation?.parentSpanId || record.details?.parentSpanId || 'Not recorded'], ['Parse status', result.parseError || record.parseError], ['Provenance note', provenance.note]
            ].filter(([, value]) => value !== undefined && value !== null && value !== '');
