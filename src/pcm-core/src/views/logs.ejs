                <button class="btn btn-outline-secondary" title="Toggle empty spacer below selected row" onclick="toggleSelectedSpacer('after')" data-help-key="logs.spacer-below">Spacer below</button>
            </div>
            <button class="btn btn-sm btn-outline-secondary ms-2" title="Insert an empty spacer at the newest log entry, respecting whether the log tail is displayed at the top or bottom." onclick="addLogTailSpacer()" data-help-key="logs.spacer-tail">Spacer at log tail</button>

                        </div></details>
                        <p><a class="btn" href="<%= basePath %>/admin/logs/download" data-help-key="diagnostics.download">Full logs JSON (Admin)</a></p>
                        <p>Full records load on selection, up to 256 KiB per line. Export includes retained history and requires Admin authorization. Handle exports as sensitive. AWS-safe projections are always labeled.</p>
            <button class="btn btn-sm btn-outline-danger" onclick="clearLogs()" data-help-key="logs.clear" title="Clear built-in current and retained history; read-only extension sources are retained">Clear built-in logs</button>
                    </section>
                </div>
            </div>
        </div>
