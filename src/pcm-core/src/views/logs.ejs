        /** Fetch only the selected record; selection revisions also handle A → B → A races. */
        async function selectLog(id, entry, savedRecord = null, verifiedDetail = null) {
            const selected = savedRecord || currentLogs.find(log => log.id === id);
            if (!selected) return;
            activeDetailRead?.abort();
            const controller = new AbortController();
            activeDetailRead = controller;
            logClipboard()?.cancel();
            const revision = ++detailRevision;
            const preferFhir = activeDetailTab === 'fhir';
            selectedId = id; selectedRecord = selected; selectedResult = null; selectedExplorer = null;
            holdReading(); openEventDetail(entry);
            detailTabScroll = { json: { top: 0, left: 0 }, structured: { top: 0, left: 0 }, fhir: { top: 0, left: 0 }, raw: { top: 0, left: 0 } };
            eventScrollState = { metadata: 0, outer: 0 }; restoreEventScroll();
