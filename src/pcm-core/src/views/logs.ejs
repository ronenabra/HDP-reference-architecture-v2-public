        }
        function conciseRole(log) {
            const role = roleFor(log);
            return { pcm: 'PCM', doctor: 'Doctor', gateway: 'Gateway', adapter: 'Adapter',
                hapi: 'HAPI runtime', 'hapi-import': 'HAPI import', fhir: 'Legacy FHIR', application: 'App',
                middleware: 'Middleware', security: 'Security', addon: 'Add-on' }[role] || 'Unknown';
        }
        function conciseOrganization(log) {
            const organization = log.event?.source?.healthOrganizationId || log.details?.healthOrganizationId || '';
            if (/^ho-[a-z0-9]+$/i.test(organization)) return organization.toUpperCase();
            // Preserve custom organization and extension labels rather than inventing abbreviations.
