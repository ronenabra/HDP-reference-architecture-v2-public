                <section id="panel-fhir" class="payload-panel" role="tabpanel" aria-labelledby="tab-fhir" hidden><div id="fhir-exchange-host" tabindex="0" aria-label="Recorded FHIR exchange"></div></section>
                <section id="panel-raw" class="payload-panel" role="tabpanel" aria-labelledby="tab-raw"${activeDetailTab !== 'raw' ? ' hidden' : ''}>${raw}</section>`;
        }
        function setDetailMessage(message) {
            selectedFhir = null;
            const content = `<p class="detail-empty">${escapeHtml(message)}</p>`;
            document.getElementById('details-pane').innerHTML = detailPanels(content, content);
            document.getElementById('detail-status').textContent = message;
