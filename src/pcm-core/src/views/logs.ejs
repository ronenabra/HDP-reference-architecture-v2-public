        /** Resolve the normalized record and exact source projection once per render. */
        function selectedRecordModel(selected, result = {}) {
            const record = result.entry || { ...selected, details: result.details ?? selected.details ?? {} };
            const provenance = result.provenance || provenanceFor(record);
            return { record, provenance,
                source: result.source || { componentId: record.event?.source?.componentId, logFile: record.logFile, byteOffset: record.componentLine },
                raw: typeof result.raw === 'string' ? result.raw : (typeof record.raw === 'string' ? record.raw : null),
                derived: provenance.kind === 'derived',
                rawRedacted: result.rawRedacted === true || record.rawRedacted === true };
        }
        function detailPanels(structured, raw, json = structured) {
