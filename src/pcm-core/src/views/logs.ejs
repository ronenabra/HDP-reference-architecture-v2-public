<% const basePath = typeof browserBase === 'string' ? browserBase : ''; %>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Unified System Logs</title>
    <link rel="stylesheet" href="<%= basePath %>/assets/connectathon.css">
    <script defer src="<%= basePath %>/assets/connectathon.js"></script>
    <script defer src="<%= basePath %>/assets/help-values.js"></script>
    <script defer src="<%= basePath %>/assets/log-record-explorer.js"></script>
    <script defer src="<%= basePath %>/assets/log-fhir-exchange.js"></script>
    <script defer src="<%= basePath %>/assets/log-clipboard.js"></script>
    <script defer src="<%= basePath %>/assets/log-columns.js"></script>
    <style>
        :root { --logs-ink: #182b46; --logs-accent: #1766d5; --logs-border: #c8d3e2; }
        body { height: 100vh; height: 100dvh; overflow: hidden; display: flex; flex-direction: column; background: #e9eef5; color: var(--logs-ink); }
        [hidden] { display: none !important; }
        .logs-page { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; overflow: hidden; }
        .workspace-heading { min-height: 58px; padding: 12px 190px 12px 20px; display: flex; align-items: center; gap: 12px; background: #152b49; color: #fff; border-bottom: 3px solid #458cff; }
        .workspace-heading h1 { margin: 0; font-size: 19px; font-weight: 700; letter-spacing: -.02em; }
        .workspace-heading .badge { background: #345477; font-size: 12px; font-weight: 600; }
        .command-bar { padding: 9px 16px; display: flex; align-items: center; flex-wrap: wrap; gap: 8px; border-bottom: 1px solid var(--logs-border); background: #fff; }
        .command-bar .btn-group { gap: 0; flex-wrap: nowrap; }
        .command-bar .btn-group .btn { border-radius: 0; }
        .command-bar .btn-group .btn:first-child { border-radius: 5px 0 0 5px; }
        .command-bar .btn-group .btn:last-child { border-radius: 0 5px 5px 0; margin-left: -1px; }
        .btn { font-size: 12px; font-weight: 600; min-height: 32px; padding: 5px 10px; border-color: #9aacc3; color: #253e61; border-radius: 5px; }
        .btn.active, .btn[aria-pressed="true"], .btn[aria-expanded="true"], #follow-latest.pending { background: #165fc7; color: #fff; border-color: #165fc7; }
        .command-spacer { flex: 1; }
        .diagnostic-control { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; }
        .scope-strip { padding: 7px 18px; background: #eaf1fb; border-bottom: 1px solid var(--logs-border); font-size: 12px; display: flex; align-items: center; gap: 6px 12px; flex-wrap: wrap; }
        #reader-indicator { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: #184e91; max-width: 100%; }
        #state-cue { display: inline-grid; place-items: center; flex-shrink: 0; border: 1px solid currentColor; border-radius: 3px; min-width: 20px; height: 20px; font-size: 14px; }
        #reader-indicator[data-state="failed"] { color: #8b231e; }
        #view-state { overflow-wrap: anywhere; }
        #diagnostic-visibility { white-space: nowrap; }
        .scope-details { min-width: 0; color: #344f73; }
        .scope-details[open] { flex-basis: 100%; order: 3; }
        #filter-summary { cursor: pointer; overflow-wrap: anywhere; }
        #filter-full { max-width: 100%; max-height: 24vh; overflow: auto; padding: 12px; background: white; border: 1px solid #768fae; border-radius: 4px; box-shadow: 0 3px 10px #0003; overflow-wrap: anywhere; }
        #monitor-status { overflow-wrap: anywhere; color: #8b231e; }
        #monitor-status, #critical-diagnostic-notice { order: 4; }
        #critical-diagnostic-notice { white-space: normal; text-align: left; overflow-wrap: anywhere; }
        #reader-indicator:focus-visible, #filter-summary:focus-visible, #diagnostic-visibility:focus-visible { outline: 3px solid #1f6feb; outline-offset: 2px; }
        .coverage-action { min-height: 36px; display: inline-flex; align-items: center; margin: 3px 3px 3px 0; padding: 6px; overflow-wrap: anywhere; max-width: 100%; text-align: left; }
        .coverage-action:focus-visible { outline: 3px solid #1f6feb; outline-offset: 2px; }
        #source-list li, #journey-list li { margin-bottom: 12px; overflow-wrap: anywhere; }
        #source-summary { font-weight: 650; }
        #page-coverage { color: #645018; }
        #log-status { font-size: 11px; color: #3d5677; height: 28px; overflow-y: auto; flex: 1; min-width: 0; }
        .investigation-banner { padding: 8px 18px; background: #fff2cf; border-bottom: 1px solid #d5ae50; display: flex; align-items: center; gap: 12px; font-size: 12px; }
        .investigation-banner strong { display: block; }
        .investigation-banner p { margin: 0; }
        .content { --sidebar-width: clamp(310px, 28vw, 414px); flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; overflow: hidden; position: relative; }
        .main-pane { display: flex; flex: 1; min-height: 0; min-width: 0; width: 100%; }
        .log-list { flex: 1; min-width: 0; min-height: 0; overflow: auto; background: #fff; overflow-anchor: none; }
        .log-list table { min-width: 780px; table-layout: fixed; width: 100%; border-collapse: collapse; }
        .table-fixed-head { position: sticky; top: 0; z-index: 5; background: #dce7f5; box-shadow: 0 1px 0 #a9bad1; }
        .table-fixed-head th { color: #233e62; font-size: 11px; font-weight: 750; text-transform: uppercase; letter-spacing: .035em; padding: 9px 10px; white-space: nowrap; }
        .log-row { cursor: pointer; font-size: 12px; height: 35px; }
        .log-row td { padding: 7px 10px; border-bottom: 1px solid #e2e8f1; background: transparent; vertical-align: middle; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .log-row:nth-child(even) { background: #f5f8fc; }
        .log-row:hover { background: #e5efff; }
        .log-row.selected { background: #d5e7ff !important; box-shadow: inset 4px 0 #1766d5; outline: 1px solid #80ace8; outline-offset: -1px; }
        .log-row:focus-visible, .resizer:focus-visible { outline: 3px solid #1262cd; outline-offset: -3px; }
        .log-row.mark-yellow { background: #fff0b7 !important; }
        .log-row.mark-green { background: #d0efdb !important; }
        .log-row.mark-red { background: #ffd9d9 !important; }
        .log-row.selected[class*="mark-"] { outline: 2px solid #174c95; outline-offset: -2px; }
        .log-time, .correlation-cell { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; }
        .event-kind { text-align: center; font-size: 16px; }
        .column-options { display: grid; gap: 6px; border: 0; padding: 0; }
        .column-options label { display: flex; align-items: center; gap: 8px; min-height: 34px; }
        .id-button { font: inherit; padding: 4px; min-height: 28px; max-width: 100%; border: 1px solid #b3c4da; border-radius: 3px; background: #f4f8fe; color: #174c95; cursor: pointer; }
        #column-id-dialog { width: min(460px, 90vw); box-sizing: border-box; border: 1px solid #95a9c2; border-radius: 6px; padding: 20px; }
        #column-id-dialog::backdrop { background: #10233b77; }
        #column-id-value { width: 100%; box-sizing: border-box; min-height: 70px; }
        .component-cell { display: flex; align-items: center; gap: 6px; min-width: 0; }
        .component-org { font-size: 11px; font-weight: 700; overflow: hidden; text-overflow: ellipsis; color: #3b5170; }
        .role-badge { color: #fff; background-color: #475569; font-size: 10px; font-weight: 750; white-space: nowrap; padding: 3px 6px; border-radius: 4px; }
        .role-badge.role-pcm { background-color: #174c99; }
        .role-badge.role-doctor { background-color: #087279; }
        .role-badge.role-gateway { background-color: #6a3bab; }
        .role-badge.role-adapter { background-color: #98521f; }
        .role-badge.role-hapi { background-color: #3a6c32; }
        .role-badge.role-hapi-import { background-color: #3a6c32; }
        .role-badge.role-fhir { background-color: #914375; }
        .role-badge.role-application { background-color: #245e87; }
        .role-badge.role-middleware { background-color: #605095; }
        .role-badge.role-security { background-color: #176052; }
        .role-badge.role-addon { background-color: #725167; }
        .severity-error { color: #b2182d; font-weight: 800; }
        .severity-warning { color: #865200; font-weight: 800; }
        .severity-default { color: #415778; font-size: 11px; font-weight: 650; }
        .message-cell { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 11px; }
        .provenance-chip { font-family: system-ui, sans-serif; color: #624080; background: #eee4fb; border: 1px solid #c9b0e4; border-radius: 3px; padding: 1px 4px; margin-right: 6px; font-size: 10px; }
        .flow-group td { padding: 5px 10px; background: #e7edf7; border-bottom: 1px solid #bccce1; font-size: 11px; color: #385274; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .flow-group strong { color: #223e64; }
        .flow-group .flow-description { margin-left: 10px; }
        .spacer-row td { height: 12px; padding: 0; background: repeating-linear-gradient(45deg, #f0f3f8, #f0f3f8 6px, #dce4ef 6px, #dce4ef 12px); }
        .workbench { width: var(--sidebar-width); min-width: 0; max-width: 50%; flex: 0 0 auto; display: flex; flex-direction: column; background: #f7f9fd; border-left: 1px solid #b1c3db; box-shadow: -4px 0 18px #1f3c6212; z-index: 8; }
        .workbench-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; padding: 8px 12px; background: #f0f5fc; color: #253e61; border-bottom: 1px solid var(--logs-border); gap: 8px; }
        .workbench-heading h2 { margin: 0; font-size: 14px; }
        .workbench-heading > .btn { background: transparent; color: #405f85; border-color: transparent; min-height: 28px; padding: 4px; }
        .workbench-tabs { order: 2; display: flex; padding: 0; gap: 4px; flex: 1 0 100%; }
        .workbench-tabs .btn { flex: 1; padding-inline: 4px; border-color: transparent; background: transparent; border-radius: 0; color: #456184; }
        .workbench-tabs .btn[aria-selected="true"] { color: #165fc7; box-shadow: inset 0 -3px #165fc7; }
        .workbench-body { overflow: auto; min-height: 0; flex: 1; }
        .workbench-section { padding: 16px; font-size: 12px; }
        .workbench-section h2 { font-size: 16px; margin-top: 0; }
        .workbench-section h3 { font-size: 13px; }
        .workbench-section p { overflow-wrap: anywhere; }
        .record-metadata { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 7px 10px; }
        .record-metadata dt, .record-metadata dd { margin: 0; overflow-wrap: anywhere; }
        .record-metadata dt { color: #54667f; }
        .record-metadata dd { font-family: ui-monospace, monospace; font-size: 11px; }
        .detail-notice, #selection-state { padding: 9px 11px; border-left: 3px solid #8c63b4; background: #ede4f6; font-size: 12px; }
        #selection-state { margin: 0; padding: 5px 16px; border-color: #c18c28; background: #fff0cd; font-size: 11px; }
        .detail-actions { display: flex; flex-wrap: wrap; gap: 7px; margin-block: 12px; }
        #search-banner { flex-wrap: wrap; overflow-wrap: anywhere; }
        #search-banner > div { flex: 1 1 280px; min-width: 0; }
        #search-banner p { margin: 3px 0 0; }
        .filters-panel { font-size: .875rem; }
        .filters-panel p { line-height: 1.5; }
        .log-filters { display: grid; gap: 16px; min-width: 0; }
        /* Fit columns to the available sidebar and text size, not the viewport.
           Full-width IDs and UTC bounds stay useful even when compact fields pair. */
        .filter-fields { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr)); gap: 14px 12px; min-width: 0; }
        .filter-fields > div { display: flex; flex-direction: column; min-width: 0; }
        .filter-fields .filter-field-wide { grid-column: 1 / -1; }
        .filter-fields label { display: block; flex: 1; font-size: .8125rem; font-weight: 650; line-height: 1.4; margin-bottom: 6px; overflow-wrap: anywhere; }
        .filter-fields input, .filter-fields select { box-sizing: border-box; width: 100%; max-width: 100%; min-width: 0; min-height: 44px; font-size: .875rem; line-height: 1.4; border: 1px solid #95a9c2; border-radius: 4px; padding: 9px 10px; background: #fff; }
        .filter-actions { display: flex; flex-wrap: wrap; gap: 12px; min-width: 0; }
        .log-filters .btn { min-width: 0; min-height: 44px; font-size: .875rem; line-height: 1.4; padding: 10px 12px; white-space: normal; overflow-wrap: anywhere; }
        .filter-actions .btn { flex: 1 1 9rem; }
        .filter-fields :is(input, select):focus-visible, .log-filters .btn:focus-visible, .filter-diagnostics input:focus-visible { outline: 3px solid #1f6feb; outline-offset: 2px; }
        .log-filters .filter-apply { background: #165fc7; border-color: #165fc7; color: #fff; }
        .filter-search-actions { display: grid; gap: 10px; min-width: 0; padding-top: 16px; border-top: 1px solid var(--logs-border); }
        .filter-search-actions p { margin: 0; font-size: .8125rem; }
        .filter-diagnostics { margin-top: 20px; padding-top: 16px; border-top: 1px solid var(--logs-border); }
        .filter-diagnostics .diagnostic-control { display: flex; align-items: flex-start; gap: 8px; min-height: 44px; padding: 10px 0; font-size: .875rem; line-height: 1.4; white-space: normal; overflow-wrap: anywhere; }
        .filter-diagnostics input { flex: 0 0 auto; width: 20px; height: 20px; margin-top: 0; }
        .filter-diagnostics p { margin: 6px 0 0; font-size: .8125rem; }
        .log-controls .d-flex { flex-wrap: wrap; gap: 10px; }
        .log-controls > summary { font-weight: 700; margin-bottom: 12px; cursor: pointer; }
        .role-legend { display: flex; flex-wrap: wrap; gap: 6px; }
        .journey-list { padding-left: 18px; }
        .journey-list li { margin: 10px 0; overflow-wrap: anywhere; }
        .workbench-section details { margin: 12px 0; }
        .workbench-section summary { cursor: pointer; font-weight: 700; }
        pre { background: #eaf0f8; color: #203c60; padding: 12px; border: 1px solid #bdcce0; border-radius: 5px; white-space: pre-wrap; word-break: break-word; font-size: 11px; max-height: 320px; overflow: auto; }
        .resizer { height: 9px; width: 100%; flex: 0 0 9px; background: #e1eafa; border-block: 1px solid #abc0dd; cursor: row-resize; touch-action: none; position: relative; }
        .resizer::after { content: ''; position: absolute; top: 2px; left: calc(50% - 24px); width: 48px; height: 3px; border-block: 1px solid #7a96bc; }
        body.resizing-event, body.resizing-event * { cursor: row-resize !important; user-select: none !important; }
        .event-detail { height: 48%; flex: 0 0 auto; min-height: 0; display: grid; grid-template-columns: minmax(0, 1fr) var(--sidebar-width); background: #fff; }
        .event-main { display: flex; flex-direction: column; min-width: 0; min-height: 0; overflow: auto; }
        .event-heading { flex-shrink: 0; display: flex; align-items: center; gap: 10px; min-height: 43px; padding: 7px 16px; background: #f4f8fe; border-bottom: 1px solid var(--logs-border); }
        .event-heading h2, .event-metadata h2 { font-size: 14px; margin: 0; white-space: nowrap; }
        #event-selection-label { font-size: 10px; color: #3a6494; border: 1px solid #c4d7f0; background: #eaf2ff; padding: 3px 6px; white-space: nowrap; border-radius: 3px; }
        #event-message { min-width: 0; flex: 1; font-size: 11px; color: #526c8e; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
        .event-heading .btn { margin-left: auto; color: #436188; background: transparent; border-color: transparent; white-space: nowrap; }
        .detail-toolbar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; border-bottom: 1px solid var(--logs-border); padding: 0 12px; flex-shrink: 0; }
        .detail-tabs { display: flex; flex-wrap: wrap; align-self: stretch; }
        #fhir-exchange-host { flex: 1; min-height: 0; overflow: auto; padding: 18px 20px; font-size: 12px; overflow-wrap: anywhere; }
        #fhir-exchange-host:empty { padding: 0; }
        #fhir-exchange-host pre { flex: none; min-height: 24px; margin: 0; padding: 13px 15px; border: 1px solid var(--logs-border); border-radius: 4px; background: #f5f8fd; font: 12px/1.65 ui-monospace, SFMono-Regular, Consolas, monospace; white-space: pre-wrap; }
        .log-details-pane.no-wrap #fhir-exchange-host pre { white-space: pre; }
        #fhir-exchange-host .btn { min-height: 36px; white-space: normal; }
        .fhir-candidate { display: grid; gap: 10px; min-width: 0; }
        .fhir-candidate + .fhir-candidate { margin-top: 22px; border-top: 1px solid var(--logs-border); padding-top: 22px; }
        .fhir-heading { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        #fhir-exchange-host h3 { margin: 0; font-size: 14px; font-weight: 600; }
        .fhir-heading .btn { margin-left: auto; }
        #fhir-exchange-host .fhir-note { margin: 0; color: #526c8e; }
        .fhir-status { color: #526c8e; }
        .fhir-status.fhir-error { color: #a33228; }
        #fhir-exchange-host summary { color: #526c8e; cursor: pointer; padding: 3px 0; }
        #fhir-exchange-host details[open] summary { margin-bottom: 8px; }
        #fhir-exchange-host details .btn { margin-top: 8px; }
        #fhir-exchange-host summary:focus-visible { outline: 2px solid #105fc9; outline-offset: 3px; }
        @media (max-width: 480px) {
            #fhir-exchange-host { padding: 14px; }
            #fhir-exchange-host pre { padding: 12px; }
            #fhir-exchange-host .btn { min-height: 40px; }
        }
        .detail-tab { min-height: 40px; border: 0; border-bottom: 3px solid transparent; border-radius: 0; padding: 8px 10px; background: transparent; color: #526c8e; font-size: 12px; }
        .detail-tab[aria-selected="true"] { color: #105fc9; border-bottom-color: #1766d5; background: #f6f9ff; }
        .detail-tools { display: flex; align-items: center; gap: 5px; }
        .detail-tools .btn { font-size: 10px; border-color: transparent; min-height: 28px; }
        .log-details-pane { display: flex; flex-direction: column; flex: 1; min-height: 96px; min-width: 0; overflow: auto; background: #fafdff; }
        .payload-panel { display: flex; flex-direction: column; flex: 1; min-height: 0; }
        #panel-structured { display: block; }
        #panel-structured[hidden] { display: none; }
        #record-explorer-host { padding: 12px 16px; font-size: 12px; overflow-wrap: anywhere; }
        #record-explorer-host details { margin: 8px 0; }
        #record-explorer-host summary { cursor: pointer; font-weight: 650; padding: 6px 0; }
        #record-explorer-host .btn { margin: 4px; min-height: 32px; font-size: 11px; white-space: normal; }
        #record-explorer-host input { max-width: 100%; min-height: 34px; }
        .explorer-children { margin-left: 10px; border-left: 1px solid #a5bbd5; padding-left: 6px; }
        .explorer-row, .field-match, .specialized-field { padding: 5px 0; border-bottom: 1px solid #e1eafa; }
        .field-label { display: block; font-family: ui-monospace, monospace; }
        #panel-structured pre { max-height: 320px; min-height: 32px; }
        .payload-description { margin: 0; padding: 8px 16px; font-size: 11px; color: #4a6589; border-bottom: 1px solid #e1eafa; background: #fff; flex-shrink: 0; }
        .payload-description.detail-notice { color: #593877; background: #f4eefb; }
        .payload-panel pre { flex: 1; min-height: 0; max-height: none; margin: 0; padding: 14px 20px; border: 0; border-radius: 0; background: #f8fbff; color: #234b78; font-size: 12px; line-height: 1.65; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; word-break: normal; tab-size: 2; }
        .log-details-pane.no-wrap pre { white-space: pre; overflow-wrap: normal; }
        .detail-empty { padding: 16px; font-size: 12px; }
        .detail-footer { flex-shrink: 0; padding: 4px 16px; min-height: 25px; background: #eef4fc; color: #4e6c91; font-size: 10px; border-top: 1px solid #d6e2f2; }
        .event-metadata { display: flex; flex-direction: column; min-height: 0; min-width: 0; background: #f5f8fe; border-left: 1px solid #b1c3db; }
        .event-metadata > header { display: flex; align-items: center; min-height: 43px; padding: 7px 16px; border-bottom: 1px solid var(--logs-border); }
        .event-metadata > header span { margin-left: auto; font-size: 10px; color: #54749c; }
        .event-metadata-body { overflow: auto; padding: 14px 16px; font-size: 11px; min-height: 0; }
        .event-source-label { display: flex; align-items: flex-start; gap: 6px; margin: 0 0 12px; font-weight: 650; color: #294d7a; }
        .event-source-label > span:last-child { overflow-wrap: anywhere; min-width: 0; }
        .event-metadata .detail-actions { flex-wrap: wrap; }
        .event-metadata .detail-actions .btn { flex: 1; padding: 5px; font-size: 10px; }
        .event-metadata .detail-notice { font-size: 11px; margin: 10px 0; }
        .event-metadata .small { font-size: 10px; }
        .resizer:hover, .resizer.resizing { background: #1766d5; }
        .drawer-backdrop { display: none; }
        @media (max-width: 767.98px) {
            .workspace-heading { min-height: 51px; padding: 10px 120px 10px 12px; gap: 8px; }
            .workspace-heading h1 { font-size: 15px; }
            .workspace-heading .badge { font-size: 10px; }
            .command-bar { gap: 6px; padding: 7px 10px; }
            .command-bar .btn, .diagnostic-control { font-size: 10px; min-height: 34px; padding-inline: 7px; }
            .command-bar .btn-group { width: auto; }
            .command-bar .btn-group .btn { width: auto; flex: 0 1 auto; }
            .table-fixed-head th { padding: 8px; font-size: 10px; }
            .log-row td { padding: 7px 8px; }
            .component-cell { gap: 7px; }
            .command-spacer { display: none; }
            .scope-strip { padding: 6px 10px; font-size: 11px; }
            /* Reserve stable space for changing held-read status without hiding failures. */
            #log-status { display: block; height: 28px; line-height: 14px; overflow: auto; }
            .scope-strip { align-items: flex-start; gap: 7px 12px; }
            .scope-details { flex-basis: 100%; order: 3; }
            #filter-full { position: static; max-width: 100%; }
            #monitor-status, #critical-diagnostic-notice { flex-basis: 100%; order: 4; }
            #follow-latest { width: 144px; height: 34px; line-height: 12px; flex: 0 0 144px; }

            .investigation-banner { padding: 6px 10px; display: grid; grid-template-columns: 1fr auto; gap: 5px; font-size: 11px; }
            .investigation-banner > div { grid-column: 1 / -1; grid-row: 1; }
            .investigation-banner .btn { justify-self: start; white-space: nowrap; min-height: 28px; padding: 3px 7px; font-size: 10px; }
            .investigation-banner p { overflow-wrap: anywhere; }
            /* Keep query progress, Return and event space available while the
               full exact-ID context remains keyboard/touch scrollable. */
