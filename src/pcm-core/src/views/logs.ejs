                    <thead class="table-fixed-head"><tr>
<th scope="col" data-column="time" data-help-key="logs.time">Time</th><th scope="col" data-column="component" data-help-key="logs.component">Component</th><th scope="col" data-column="correlationId" data-help-key="logs.correlation">Correlation ID</th><th scope="col" data-column="flowId" data-help-key="logs.flow-id">Flow ID</th><th scope="col" data-column="traceId" data-help-key="logs.trace-id">Trace ID</th><th scope="col" data-column="kind" title="Request, response, processing or Other/unknown, based on the recorded event type">Type</th><th scope="col" data-column="level" data-help-key="logs.level">Level</th><th scope="col" data-column="class" data-help-key="logs.class">Class</th><th scope="col" data-column="message" data-help-key="logs.message">Message</th></tr></thead><tbody id="log-table-body"></tbody>
