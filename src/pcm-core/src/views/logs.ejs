                <dl class="record-metadata">${metadata.map(([name, value]) => `<dt data-help-key="${escapeAttribute(metadataHelp(name))}">${escapeHtml(name)}</dt><dd>${escapeHtml(value)}</dd>`).join('')}</dl>
                ${derived ? '<p class="detail-notice">Derived gateway request: reconstructed from a gateway access/response record. There is no separately captured raw request for this event.</p>' : ''}
                <div class="detail-actions">${getCorrelationId(record) ? `<a class="btn" href="${escapeAttribute(inspectJourneyUrl('correlationId', getCorrelationId(record)))}" data-help-key="logs.inspect-correlation" data-inspect-field="correlationId" data-inspect-value="${escapeAttribute(getCorrelationId(record))}" onclick="inspectJourney(event, this.dataset.inspectField, this.dataset.inspectValue)">Inspect related correlation across roles →</a>` : ''}
                ${getFlowId(record) ? `<a class="btn" href="${escapeAttribute(inspectJourneyUrl('flowId', getFlowId(record)))}" data-help-key="logs.inspect-flow" data-inspect-field="flowId" data-inspect-value="${escapeAttribute(getFlowId(record))}" onclick="inspectJourney(event, this.dataset.inspectField, this.dataset.inspectValue)">Inspect this flow across roles →</a>` : ''}
                ${getTraceId(record) ? `<a class="btn" href="${escapeAttribute(inspectJourneyUrl('traceId', getTraceId(record)))}" data-help-key="logs.inspect-trace" data-inspect-field="traceId" data-inspect-value="${escapeAttribute(getTraceId(record))}" onclick="inspectJourney(event, this.dataset.inspectField, this.dataset.inspectValue)">Inspect this trace across roles →</a>` : ''}</div>
                ${getCorrelationId(record) || getFlowId(record) || getTraceId(record) ? '<p class="small">Each action searches only its exact recorded ID across roles and organizations. Other filters are set aside; Diagnostics stays unchanged. Correlation can expose related exchanges with different trace IDs; it does not broaden a Trace result. Return restores your view.</p>' : ''}`;
