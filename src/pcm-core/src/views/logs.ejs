        }
        /** Payload tabs are distinct DOM panels; raw text is never reformatted. */
        function renderSelectedRecord(selected, result = {}) {
            const { record, raw, rawRedacted, derived } = selectedRecordModel(selected, result);
            selectedFhir = result.entry ? window.PCM_LOG_FHIR.extract(record) : null;
            const structured = `<p class="payload-description"><strong>Recorded event facts.</strong> Explore fields and recorded views; missing facts remain unavailable.</p>
                ${nativeLifecycleNote(record) ? '<p class="detail-notice">' + escapeHtml(nativeLifecycleNote(record)) + '</p>' : ''}
                <div id="record-explorer-host"></div>`;
            const rawLabel = rawRedacted ? 'AWS-safe source projection' : 'Exact raw source text';
            const note = rawRedacted
                ? 'AWS-safe source projection; original raw withheld/blocked. This is the server-provided safe projection, not the exact original source record.'
                : 'Source text as returned, without JSON reformatting. Malformed and plain text stay intact.';
            const rawPanel = `<p class="payload-description${rawRedacted ? ' detail-notice' : ''}"><strong>${rawLabel}.</strong> ${note}${derived ? ' Derived request: the source text belongs to the gateway response record.' : ''}</p>
                ${raw === null ? '<p class="detail-notice">Raw source text is unavailable in this response. Use the authenticated full export to inspect the retained source.</p>' : `<pre tabindex="0" aria-label="Raw source text" class="raw-source-text">${escapeHtml(raw)}</pre>`}`;
            const json = `<pre tabindex="0" aria-label="Complete normalized JSON" data-help-key="logs.payload">${escapeHtml(JSON.stringify(record, null, 2))}</pre>`;
