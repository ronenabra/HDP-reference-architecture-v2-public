        /** Count recorded IDs independently; a row may belong to several observed groups. */
        function pageJourneySummary(entries) {
            const groups = new Map();
            let uncorrelated = 0;
            for (const entry of entries) {
                const ids = [['flowId', 'Flow', getFlowId(entry)], ['traceId', 'Trace', getTraceId(entry)], ['correlationId', 'Correlation / request', getCorrelationId(entry)]];
                if (!ids.some(([, , id]) => id)) uncorrelated++;
                for (const [field, kind, id] of ids) {
                    if (!id) continue;
                    const key = `${field}:${id}`;
                    if (!groups.has(key)) groups.set(key, { field, kind, id: String(id), count: 0, roles: new Set() });
                    const group = groups.get(key); group.count++; group.roles.add(roleFor(entry));
                }
