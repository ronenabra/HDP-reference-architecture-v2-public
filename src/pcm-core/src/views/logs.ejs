            const notices = [...new Set(reasons.map(reason => labels[reason] || reason))];
            if (result.failures?.length) notices.push('Unavailable in this evidence response: ' + result.failures.map(item => item.component || item.sourceId || 'unknown source').join(', ') + '.');
            if (result.skippedLongLines || result.progress?.skippedLongLines) notices.push(`${result.skippedLongLines || result.progress.skippedLongLines} oversized records omitted.`);
            if (currentCoverage?.note && currentCoverage.scope === 'selected-observed-event') notices.push(currentCoverage.note);
            document.getElementById('page-coverage').textContent = `Evidence in the ${scope}: ${currentLogs.length - (searchSession?.previewVisible ? 1 : 0)} events${searchSession?.previewVisible ? ' plus one selected-event preview, not counted as a search match' : ''}. ${notices.join(' ')} ${!currentLogs.length ? 'No matching evidence is loaded; an empty view does not prove that no activity occurred. ' : ''}Evidence is limited to current files and up to five retained rotations per source; older or never-recorded events cannot be recovered by filtering. Diagnostics ${showDiagnosticLogs ? 'shown' : 'hidden'}.`;
            document.getElementById('coverage-active-filters').innerHTML = ['source', 'role', 'healthOrganizationId'].filter(field => new URLSearchParams(searchSession ? searchSession.filters : window.location.search).get(field)).map(field => {
                const value = new URLSearchParams(searchSession ? searchSession.filters : window.location.search).get(field);
                return `<button type="button" class="btn coverage-action" data-help-key="logs.coverage-remove" data-coverage-filter="${field}" data-value="">Remove ${escapeHtml(field)}=${escapeHtml(value)}</button>`;
            }).join('');
            const observedEntries = searchSession?.previewVisible ? currentLogs.filter(entry => entry.id !== searchSession.seed?.id) : currentLogs;
            const summary = pageJourneySummary(observedEntries);
            document.getElementById('journey-summary').textContent = `Observed ID groups in the ${scope}: ${summary.groups.length} · ${summary.uncorrelated} rows without recorded IDs`;
            document.getElementById('journey-list').innerHTML = summary.groups.length
                ? summary.groups.map(group => `<li><a class="coverage-action" data-help-key="logs.coverage-journey" data-coverage-journey="${group.field}" data-value="${escapeAttribute(group.id)}" href="${escapeAttribute(inspectJourneyUrl(group.field, group.id))}">Inspect ${escapeHtml(group.kind)} ${escapeHtml(group.id)} across roles</a> · ${group.count} events in this ${scope} · observed roles: ${escapeHtml([...group.roles].join(', '))}</li>`).join('')
                : '<li>No recorded ID groups in this loaded evidence. Missing IDs cannot be recovered by filtering.</li>';
            const sources = Array.isArray(result.sources) ? result.sources : [];
            const available = sources.filter(source => source.state === 'available').length;
            const unavailable = sources.filter(source => ['error', 'unavailable', 'missing'].includes(source.state)).length;
            document.getElementById('source-summary').textContent = sources.length
                ? `Sources in this evidence scope: ${sources.length} · ${available} available · ${unavailable} unavailable / missing · ${sources.length - available - unavailable} unknown`
                : 'Sources in this evidence scope: inventory unknown';
            document.getElementById('source-list').innerHTML = sources.length
                ? sources.map(source => `<li>${coverageFilterButton('source', source.componentId, source.label || source.componentId)} <span>${escapeHtml(source.componentId)} · ${escapeHtml(source.state || 'unknown')} · ${escapeHtml(source.coverage || 'coverage unknown')}</span> ${source.role ? coverageFilterButton('role', source.role, 'Role: ' + source.role) : ''} ${source.healthOrganizationId ? coverageFilterButton('healthOrganizationId', source.healthOrganizationId, 'HO: ' + source.healthOrganizationId) : ''}${source.runtimeHealth ? '<p>Native diagnostics: ' + escapeHtml(source.runtimeHealth.state) + ' · reported writer drops: ' + escapeHtml(String(source.runtimeHealth.dropped ?? 'unknown')) + ' · queued: ' + escapeHtml(String(source.runtimeHealth.queuedEntries ?? 'unknown')) + '. Diagnostic retention and collection gaps can limit this trace.</p>' : ''}${source.role === 'hapi-import' || source.coverage === 'import-only' ? '<p>Import-only: general HAPI requests and complete spans are not recorded here.</p>' : ''}</li>`).join('')
                : '<li>The server did not return a source inventory. Availability is unknown; no source action is inferred.</li>';
            document.getElementById('viewer-budgets').textContent = `Loaded ${currentLogs.length} summaries in ${logPages.length} page(s); last response read ${result.bytesRead || 0} bytes. Browse/live: 200 events and 1 MiB per request; at most 600 summaries plus one prefetched page. Retained search: up to 1,000 matches in 200-result pages. Full detail: 256 KiB per line.`;
            renderSourceCheck(); updateViewState();
        }

        function logVisibility(log) {
            return log.details?.visibility || 'default';
        }

        function logCategory(log) {
            return log.details?.category || 'uncategorized';
        }

        function formatLogClass(log) {
            const category = logCategory(log);
            const visibility = logVisibility(log);
            const label = category === 'uncategorized' ? 'Uncategorized' : category;
            return visibility === 'default' ? label : `${label}/${visibility}`;
        }

        function logClassBadge(log) {
            const category = logCategory(log);
            const visibility = logVisibility(log);
            if (visibility === 'diagnostic') return 'bg-light text-dark border';
            if (visibility === 'hidden') return 'bg-secondary';
            if (category === 'harness') return 'bg-light text-dark border';
            if (category === 'noise') return 'bg-secondary';
            return 'bg-light text-dark border';
        }

        function methodFromLog(log) {
            const details = log.details || {};
            if (details.method) return String(details.method).toUpperCase();
            const match = String(log.message || '').match(/\b(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)\b/i);
            return match ? match[1].toUpperCase() : '';
        }

        function urlFromLog(log) {
            const details = log.details || {};
            if (details.url) return details.url;
            const message = String(log.message || '');
            const absolute = message.match(/https?:\/\/\S+/i);
            if (absolute) return absolute[0];
            const relative = message.match(/\s(\/[^\s]+)/);
            return relative ? relative[1] : '';
        }

        function formatLogMessage(log) {
            const details = log.details || {};
            const method = methodFromLog(log);
            const url = urlFromLog(log);
            const status = details.status ?? details.statusCode;
            const requestText = `${method} ${url}`.trim();

            if (details.type === 'OUTGOING_REQUEST') return `Request Sent: ${requestText}`;
            if (details.type === 'OUTGOING_RESPONSE') return `Response Received: ${status || ''} ${requestText}`.trim();
            if (details.type === 'OUTGOING_ERROR') {
                if (status) return `Response Error: ${status} ${requestText}`.trim();
                return `Request Failed: ${requestText} ${details.message || log.message || ''}`.trim();
            }
            if (details.type === 'REQUEST') return `Request Received: ${requestText}`;
            if (details.type === 'RESPONSE') return `Response Sent: ${status || ''} ${requestText}`.trim();
            if (details.type === 'GATEWAY_REQUEST') return `${provenanceFor(log).kind === 'derived' ? 'Derived Gateway Request' : 'Gateway Request'}: ${requestText}`.trim();
            if (details.type === 'GATEWAY_RESPONSE') return `Gateway Response: ${status || ''} ${requestText}`.trim();
            if (details.type === 'GATEWAY_ERROR') return `Gateway Error: ${details.nginxLevel || log.level || ''} ${details.raw || log.message || ''}`.trim();
            if (details.type === 'HARNESS_ACTION_STARTED') return `Harness Started: ${details.operation || ''}`.trim();
            if (details.type === 'HARNESS_ACTION_COMPLETED') return `Harness Completed: ${details.operation || ''}`.trim();
            if (details.type === 'HARNESS_ACTION_FAILED') return `Harness Failed: ${details.operation || ''} ${details.error?.message || ''}`.trim();
            if (details.type === 'DATA_FETCH_UNEXPECTED_RESPONSE') return `Data Fetch Unexpected Response: ${details.classification || ''}`.trim();
            if (details.type === 'ROUTE_ERROR') return `Route Error: ${method} ${url}`.trim();
            if (String(details.type || '').startsWith('PROCESS_')) return details.type.replace(/_/g, ' ');
            if (details.type === 'TOKEN_ISSUED') return 'Token Issued: opaque access token';
            if (details.type === 'TOKEN_VALIDATION') return 'Token Validated: local JWT';
            if (details.type === 'TOKEN_MINTED') return 'Token Minted: local JWT';
            if (details.type === 'IDENTITY_MAPPED') return `Identity Mapped: ${details.business_id} -> ${details.logical_id}`;
            if (details.type === 'INTROSPECTION_TOKEN_REFRESH') return 'Introspection Token Refresh: PCM rejected cached token; refreshing once';
            if (details.type === 'INTROSPECTION_PROCESSED') return `Introspection Result: active=${details.active}`;
            if (String(log.message || '').startsWith('Introspection Request from ')) {
                return String(log.message).replace(/^Introspection Request from /, 'Introspection Request: ').replace(' (', ' -> ').replace(/\)$/, '');
            }
            return log.message || '';
        }

        function isBottomTailMode() {
            return logOrderMode !== 'legacy' && logTailPosition === 'bottom';
        }

        function formatTimestamp(timestamp) {
            const match = String(timestamp || '').match(/T(\d{2}:\d{2}:\d{2})(?:[.Z+-]|$)/);
            return match ? match[1] : String(timestamp || '');
        }

        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function escapeAttribute(value) {
            return escapeHtml(value);
        }

        /** Apply one bounded result while retaining immutable selected details. */
        function applyLogResult(result, follow = false, preserveWindow = false) {
            observeCriticalDiagnostic(result);
            const anchor = captureAnchor();
            if (!preserveWindow) {
                cancelHistoryRead();
                logPages = [{ ...result, entries: (Array.isArray(result) ? result : result.entries || []).slice(0, LOG_PAGE_ROWS) }];
                previousCursor = result.previousCursor || null;
                latestSignature = JSON.stringify(result.entries || result);
                historyDirection = 'older';
                liveAnchor = result.liveCursor ? { liveCursor: result.liveCursor, resumeCursor: result.resumeCursor } : null;
            }
            currentResult = result;
            currentLogs = (Array.isArray(result) ? result : (result.entries || [])).slice(0, LOG_PAGE_ROWS * LOG_WINDOW_PAGES);
            nextCursor = result.nextCursor || null;
            logStatus(`${currentLogs.length} rows · ${Math.round((result.bytesRead || 0) / 1024)} KiB read${result.skippedLongLines ? ` · ${result.skippedLongLines} oversized lines: use full export` : ''}${result.failures?.length ? ` · Unavailable: ${result.failures.map(item => item.component).join(', ')}` : ''}`);
            renderPageCoverage(result);
            const tbody = document.getElementById('log-table-body');
            const logList = document.getElementById('log-list');
        const renderStarted = performance.now();
        const html = currentLogs.map(log => {
            const isSelected = selectedId === log.id ? 'selected' : '';
            const markClass = ['yellow', 'green', 'red'].includes(markedLogs[log.id]) ? `mark-${markedLogs[log.id]}` : '';
            const spacers = spacerLogs[log.id] || {};
            const levelColor = severityClass(log.level);
            const componentHelp = window.PCM_HELP_VALUES.component(roleFor(log));
            const levelHelp = window.PCM_HELP_VALUES.level(log.level);
            const classHelp = window.PCM_HELP_VALUES.category(logCategory(log));
            const componentClass = roleClass(log);
            const correlationId = getCorrelationId(log);
            const displayMessage = formatLogMessage(log);
            const displayClass = formatLogClass(log);
            const encodedLogId = encodeURIComponent(log.id);
            const hasTailSpacer = !!tailSpacerLogs[log.id];
            const tailSpacerAfter = hasTailSpacer && isBottomTailMode();
            const groupHeader = logOrderMode === 'flow' && log.flowGroup?.start
                ? `<tr class="flow-group">
                    <td data-help-key="logs.flow-summary" colspan="${Object.values(visibleColumns || {}).filter(Boolean).length || 6}" class="small text-muted">
                        <strong>${escapeHtml(log.flowGroup.title || log.flowGroup.component)}</strong> <span>· page group</span>
                        ${log.flowGroup.subtitle ? `<span class="flow-description">${escapeHtml(log.flowGroup.subtitle)}</span>` : ''}
                    </td>
                </tr>`
                : '';

            const manualBeforeId = spacerRowId(log.id, 'before');
            const manualAfterId = spacerRowId(log.id, 'after');
            const tailBeforeId = spacerRowId(log.id, 'before', 'tail');
            const tailAfterId = spacerRowId(log.id, 'after', 'tail');
            const spacerBefore = spacers.before
                ? `<tr id="${manualBeforeId}" class="spacer-row"><td colspan="${Object.values(visibleColumns || {}).filter(Boolean).length || 6}"></td></tr>`
                : ((hasTailSpacer && !tailSpacerAfter) ? `<tr id="${tailBeforeId}" class="spacer-row"><td colspan="${Object.values(visibleColumns || {}).filter(Boolean).length || 6}"></td></tr>` : '');
            const spacerAfter = spacers.after
                ? `<tr id="${manualAfterId}" class="spacer-row"><td colspan="${Object.values(visibleColumns || {}).filter(Boolean).length || 6}"></td></tr>`
                : (tailSpacerAfter ? `<tr id="${tailAfterId}" class="spacer-row"><td colspan="${Object.values(visibleColumns || {}).filter(Boolean).length || 6}"></td></tr>` : '');

            return `
            ${spacerBefore}
            ${groupHeader}
            <tr data-help-key="logs.row" id="${logRowId(log.id)}" class="log-row ${isSelected} ${markClass}"
                data-log-id="${escapeAttribute(encodedLogId)}"
                data-timestamp="${escapeAttribute(log.timestamp)}"
                data-level="${escapeAttribute(log.level)}"
                data-component="${escapeAttribute(log.component)}"
                data-message="${escapeAttribute(displayMessage)}"
                data-correlation-id="${escapeAttribute(correlationId)}"
                data-log-class="${escapeAttribute(displayClass)}"
                tabindex="0" ${isSelected ? 'aria-current="true"' : ''} aria-label="${escapeAttribute(`Select ${log.component} ${log.level}: ${displayMessage}`)}"
                onkeydown="selectLogByKeyboard(event, this)"
                onclick="selectLog(decodeURIComponent(this.getAttribute('data-log-id')), this)">
                <td data-column="time" class="log-time" data-help-key="logs.time" title="${escapeAttribute(log.timestamp)}">${escapeHtml(formatTimestamp(log.timestamp))}</td>
                <td data-column="component" data-help-key="${componentHelp}" title="${escapeAttribute(log.component + ' · ' + sourceIdentity(log))}"><span class="component-cell"><span class="badge role-badge ${componentClass}">${escapeHtml(conciseRole(log))}</span><span class="component-org">${escapeHtml(conciseOrganization(log))}</span></span></td>
                ${renderColumnId(log, 'correlationId')}${renderColumnId(log, 'flowId')}${renderColumnId(log, 'traceId')}
                ${renderColumnKind(log)}
                <td data-column="level" data-help-key="${levelHelp}" class="${levelColor}">${escapeHtml(log.level)}</td>
                <td data-column="class" data-help-key="${classHelp}" title="${escapeAttribute(displayClass)}"><span class="badge ${logClassBadge(log)}">${escapeHtml(displayClass)}</span></td>
                <td data-column="message" class="message-cell" data-help-key="logs.message" title="${escapeAttribute(displayMessage)}">${['derived', 'imported', 'unparsed'].includes(provenanceFor(log).kind) ? `<span class="provenance-chip">${escapeHtml(provenanceFor(log).kind)}</span>` : ''}${escapeHtml(displayMessage)}</td>
            </tr>
            ${spacerAfter}
            `;
        }).join('');
            // Reuse unchanged keyed rows, preserving native focus and accessibility
            // state. A held reading view never enters this path during polling.
            const template = document.createElement('template');
            template.innerHTML = `<table><tbody>${html || `<tr><td colspan="${Object.values(visibleColumns || {}).filter(Boolean).length || 6}">No matching evidence in this bounded page. More retained pages load where available. Review Coverage for filters, unavailable sources and instrumentation limits. Diagnostics preserves its explicit setting.</td></tr>`}</tbody></table>`;
            const fragment = document.createDocumentFragment();
            const existing = new Map(Array.from(tbody.children).filter(row => row.id).map(row => [row.id, row]));
            for (const row of Array.from(template.content.querySelector('tbody').children)) {
                // Normalize visibility before comparing keyed rows. Otherwise a
                // hidden column would replace every unchanged row on refresh.
                row.querySelectorAll('[data-column]').forEach(cell => { cell.hidden = visibleColumns?.[cell.dataset.column] === false; });
                row.className = Array.from(row.classList).join(' ');
                const old = row.id && existing.get(row.id);
                // Attribute insertion order changes when selection/help updates
                // a row. Structural equality preserves its focused ID buttons.
                fragment.appendChild(old && old.isEqualNode(row) ? old : row);
            }
            tbody.replaceChildren(fragment);
            syncColumns();
            if (follow) {
                restoringScroll = true;
                logList.scrollTop = isBottomTailMode() ? logList.scrollHeight : 0;
                lastScrollTop = logList.scrollTop;
                requestAnimationFrame(() => { restoringScroll = false; });
                restoreReadingFocus(anchor);
            } else restoreAnchor(anchor);
            updateSelectionState(); updateViewState();
            if (!preserveWindow) scheduleHistoryRead();
            window.logPageTimings = { server: result.timings, networkAndParseMilliseconds: window.logNetworkMilliseconds,
                renderMilliseconds: performance.now() - renderStarted, responseBytes: result.lastResponseBytes || JSON.stringify(result).length, rows: currentLogs.length };
        }

        /** Polling updates a pending snapshot while the operator is reading. */
        function refreshLogs(force = false, reset = false, preserveSelection = false) {
            if (searchSession || criticalView) return;
            if (clearing) return;
            // After clear, a held view has no snapshot. Polling must not refill
            // it before the operator explicitly requests a fresh read.
            if (!force && !followingLatest && !currentResult) return;
            if (activeRead && !force) return;
            if (!force && followingLatest && currentResult && liveAnchor) return catchUpLive();
            if (force) invalidateReads(reset && !preserveSelection);
            if (reset) {
                logPages = []; previousCursor = null; latestSignature = ''; liveAnchor = null; liveFailure = ''; catchingUp = false;
                queuedResult = null; currentResult = null; currentLogs = []; nextCursor = null; latestSourceCheck = null;
                document.getElementById('log-table-body').innerHTML = `<tr><td colspan="${Object.values(visibleColumns || {}).filter(Boolean).length || 6}">Loading bounded snapshot…</td></tr>`;
                document.getElementById('page-coverage').textContent = 'Loading page coverage…';
                document.getElementById('journey-summary').textContent = 'Observed journey groups: loading…';
                document.getElementById('journey-list').replaceChildren();
                document.getElementById('source-summary').textContent = 'Configured source coverage: loading…';
                document.getElementById('source-list').replaceChildren();
            }
            const controller = new AbortController();
            activeRead = controller;
            const revision = requestRevision;
            const params = new URLSearchParams({ order: logOrderMode, page: 'true' });
            const navigationFilters = new URLSearchParams(window.location.search);
            for (const name of FILTER_FIELDS) if (navigationFilters.has(name)) params.set(name, navigationFilters.get(name));
            if (logOrderMode !== 'legacy') params.set('tail', logTailPosition);
            params.set('diagnostics', showDiagnosticLogs ? 'true' : 'false');
            const requestedAt = performance.now();
            updateViewState();
            document.getElementById('log-list').setAttribute('aria-busy', 'true');
            // A synchronous start failure needs the same status and busy-state cleanup
            // as a rejected request, without deferring normal request initiation.
            let read;
            try {
                read = fetch(`${document.body.dataset.browserBase || ''}/api/unified-logs?${params.toString()}`, { signal: controller.signal });
            } catch (error) {
                read = Promise.reject(error);
            }
            return read
                .then(async response => {
                    const result = await response.json();
                    if (revision !== requestRevision) return null;
                    window.logNetworkMilliseconds = performance.now() - requestedAt;
                    if (!response.ok) throw new Error(result.error || `HTTP ${response.status}`);
                    return result;
                })
                .then(result => {
                    if (!result || revision !== requestRevision) return;
                    latestSourceCheck = currentResult ? { at: new Date().toISOString(), sources: result.sources, failures: result.failures } : null;
                    renderSourceCheck();
                    observeCriticalDiagnostic(result);
                    if (!force && currentResult) {
                        const sameEntries = JSON.stringify(result.entries || result) === latestSignature;
                        const sameHealth = JSON.stringify([result.failures, result.sources]) === JSON.stringify([currentResult.failures, currentResult.sources]);
                        if (!followingLatest || sameEntries && logPages.length > 1) {
                            queuedResult = !followingLatest && (!sameEntries || !sameHealth) ? result : null;
                            logStatus(`${currentLogs.length} rows${followingLatest ? '' : ' held'} · latest check ${result.failures?.length ? 'unavailable sources: ' + result.failures.map(item => item.component).join(', ') : 'succeeded'}${queuedResult ? ' · updates ready' : ''}`);
                            updateViewState();
                            return;
                        }
                    }
                    applyLogResult(result, followingLatest);
                }).catch(error => {
                    if (revision === requestRevision && error.name !== 'AbortError') {
                        latestSourceCheck = { at: new Date().toISOString(), error: error.message }; renderSourceCheck();
                        logStatus(`Log read failed: ${error.message}${currentLogs.length ? ' · showing the previous successful snapshot' : ''}`);
                        if (!currentLogs.length) {
                            document.getElementById('log-table-body').innerHTML = `<tr><td colspan="${Object.values(visibleColumns || {}).filter(Boolean).length || 6}">This page could not be loaded. Use Jump to latest to retry with a fresh snapshot.</td></tr>`;
                            document.getElementById('page-coverage').textContent = 'Page unavailable; coverage cannot be determined.';
                            document.getElementById('journey-summary').textContent = 'No page loaded';
                            document.getElementById('source-summary').textContent = 'Configured source coverage: unavailable';
                        }
                    }
                }).finally(() => {
                    if (activeRead === controller) { activeRead = null; document.getElementById('log-list').setAttribute('aria-busy', 'false'); updateViewState(); }
                });
        }

        setInterval(refreshLogs, 3000);
        window.onload = function () {
            visibleColumns = window.PCM_LOG_COLUMNS.load(() => localStorage); syncColumns();
            loadMarkedLogs(); loadEventPaneSize(); loadFilters(); updateLogControls(); saveCurrentView();
            if (!startUrlInspection()) refreshLogs(true, true);
            const list = document.getElementById('log-list');
            const readingInput = event => {
                historyError = ''; liveFailure = '';
                const movement = event?.deltaY || (['ArrowDown', 'PageDown', 'End'].includes(event?.key) ? 1 : ['ArrowUp', 'PageUp', 'Home'].includes(event?.key) ? -1 : 0);
                const direction = movement ? (movement > 0) !== isBottomTailMode() ? 'older' : 'newer' : null;
                if (direction) setHistoryDirection(direction);
                const towardLive = direction === 'newer' && historyEdgeDistance('newer') <= 48;
                if (!(towardLive && followingLatest)) holdReading();
                if (towardLive && catchingUp) followingLatest = true;
                scheduleHistoryRead();
            };
            list.addEventListener('wheel', readingInput, { passive: true });
            list.addEventListener('touchstart', readingInput, { passive: true });
            list.addEventListener('keydown', event => { if (['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End'].includes(event.key)) readingInput(event); });
            list.addEventListener('scroll', handleLogScroll, { passive: true });
            window.addEventListener('resize', () => { cancelEventResize(); syncDrawer(); resizeEventPane(eventPanePercent, false); });
            window.addEventListener('popstate', handleHistoryNavigation);
            document.addEventListener('keydown', event => {
                // The native ID dialog owns Escape and focus while open.
                if (document.getElementById('column-id-dialog').open) return;
                if (event.key === 'Escape') {
                    // Explain owns dismissal before pane/selection navigation.
                    if (event.defaultPrevented || document.getElementById('pcm-help-tooltip')?.hidden === false) return;
                    if (activePanel && (window.innerWidth < 768 || document.getElementById('workbench').contains(document.activeElement) || document.activeElement?.dataset.openPanel === activePanel)) { event.preventDefault(); closeWorkbench(); }
                    else if (eventDetailOpen) { event.preventDefault(); closeEventDetail(); }
                    else if (activePanel) { event.preventDefault(); closeWorkbench(); }
                }
                if (activePanel && event.key === 'Tab' && window.innerWidth < 768) {
                    const nodes = Array.from(document.getElementById('workbench').querySelectorAll('button, a, input, select, summary, [tabindex="0"]')).filter(node => !node.disabled && node.getClientRects().length);
                    const first = nodes[0], last = nodes[nodes.length - 1];
                    if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
                    else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
                }
            });
        };
    </script>
<script defer src="<%= basePath %>/assets/help-copy.js"></script><script defer src="<%= basePath %>/assets/help.js"></script></head>

<body data-browser-base="<%= basePath %>" data-help-team="<%= typeof teamId !== "undefined" ? teamId : "local" %>">
    <main class="logs-page" aria-labelledby="logs-title">
    <header class="workspace-heading sandbox-header" id="workspace-heading">
        <div class="sandbox-heading">
        <span class="badge" data-help-key="common.team"><%= teamId %></span>
        <h1 id="logs-title" data-help-key="logs.page">Logs</h1>
        </div>
        <nav class="sandbox-navigation" aria-label="Sandbox pages">
            <a class="btn btn-outline-secondary" data-help-key="common.nav-doctor" href="<%= typeof publicBaseUrls !== 'undefined' ? publicBaseUrls.spClient : '/ui' %>">Doctor</a>
            <a class="btn btn-outline-secondary" href="<%= basePath %>/ui" data-help-key="common.nav-consents">Consents</a>
            <a class="btn btn-outline-secondary" href="<%= basePath %>/admin/services" data-help-key="services.nav">Services</a>
            <a class="btn btn-outline-secondary" href="<%= basePath %>/admin" data-help-key="common.nav-admin">Admin</a>
            <a class="btn btn-outline-secondary" href="<%= basePath %>/logs-view" aria-current="page" data-help-key="common.nav-logs">Logs</a>
            <label class="explain-toggle" data-help-key="common.explain"><input type="checkbox"> Explain this page</label>
        </nav>
    </header>
    <nav class="command-bar" id="command-bar" aria-label="Event view controls">
        <div class="btn-group" role="group" aria-label="Event arrangement">
            <button class="btn active" data-log-order-mode="flow" onclick="setLogOrderMode('flow')" data-help-key="logs.flow-order">Group related events</button>
            <button class="btn" data-log-order-mode="timeline" onclick="setLogOrderMode('timeline')" data-help-key="logs.timeline-order">Timeline</button>
        </div>
