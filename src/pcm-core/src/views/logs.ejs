                        <button class="btn" data-help-key="logs.workbench-filters" id="workbench-tab-filters" role="tab" aria-controls="workbench-panel-filters" aria-selected="false" tabindex="-1" data-panel-tab="filters" onclick="openWorkbench('filters')">Filters</button>
                        <button class="btn" data-help-key="logs.workbench-coverage" id="workbench-tab-coverage" role="tab" aria-controls="workbench-panel-coverage" aria-selected="false" tabindex="-1" data-panel-tab="coverage" onclick="openWorkbench('coverage')">Coverage</button>
                        <button class="btn" data-help-key="logs.columns" id="workbench-tab-columns" role="tab" aria-controls="workbench-panel-columns" aria-selected="false" tabindex="-1" data-panel-tab="columns" onclick="openWorkbench('columns')">Columns</button>
                        <button class="btn" data-help-key="logs.workbench-tools" id="workbench-tab-tools" role="tab" aria-controls="workbench-panel-tools" aria-selected="false" tabindex="-1" data-panel-tab="tools" onclick="openWorkbench('tools')">Tools</button>
