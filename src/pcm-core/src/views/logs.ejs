                        <option value="gateway">Gateway</option><option value="adapter">Adapter</option><option value="hapi">HAPI runtime</option><option value="hapi-import">HAPI import only</option><option value="fhir">Legacy FHIR</option>
                        <option value="application">Application</option><option value="middleware">Middleware</option><option value="security">Security</option><option value="addon">Add-on</option>
                    </select></div>
                    <div><label for="filter-healthOrganizationId">Organization ID (exact)</label><input id="filter-healthOrganizationId" data-help-key="logs.filter-healthOrganizationId" name="healthOrganizationId" type="text" placeholder="All organizations"></div>
                    <div><label for="filter-level">Level (exact)</label><select id="filter-level" data-help-key="logs.filter-level" name="level"><option value="">All levels</option><option>ERROR</option><option>WARN</option><option>INFO</option><option>DEBUG</option><option>UNKNOWN</option></select></div>
                    <div><label for="filter-method">HTTP method (exact)</label><select id="filter-method" data-help-key="logs.filter-method" name="method"><option value="">All methods</option><option>GET</option><option>POST</option><option>PUT</option><option>PATCH</option><option>DELETE</option><option>HEAD</option><option>OPTIONS</option></select></div>
                    <div class="filter-field-wide"><label for="filter-operationId">Operation ID (exact)</label><input id="filter-operationId" data-help-key="logs.filter-operationId" name="operationId" type="text" maxlength="256"></div>
                    <div class="filter-field-wide"><label for="filter-sourceId">Registered source ID (exact)</label><input id="filter-sourceId" data-help-key="logs.filter-sourceId" name="sourceId" type="text" maxlength="256"></div>
                    <div class="filter-field-wide"><label for="filter-correlationId">Correlation ID (exact)</label><input id="filter-correlationId" data-help-key="logs.filter-correlationId" name="correlationId" type="text"></div>
                    <div class="filter-field-wide"><label for="filter-flowId">Flow ID (exact)</label><input id="filter-flowId" data-help-key="logs.filter-flowId" name="flowId" type="text"></div>
                    <div class="filter-field-wide"><label for="filter-traceId">Trace ID (exact)</label><input id="filter-traceId" data-help-key="logs.filter-traceId" name="traceId" type="text"></div>
                    <div class="filter-field-wide"><label for="filter-path">Path (exact, no query)</label><input id="filter-path" data-help-key="logs.filter-path" name="path" type="text" placeholder="/api/path"></div>
                    <div class="filter-field-wide"><label for="filter-status">HTTP status (exact)</label><input id="filter-status" data-help-key="logs.filter-status" name="status" type="text" inputmode="numeric"></div>
                    <div class="filter-field-wide"><label for="search-text">Literal message / payload text</label><input id="search-text" data-help-key="logs.search-text" type="search" maxlength="512" placeholder="Case-insensitive literal"></div>
                    <div class="filter-field-wide"><label for="search-source">Source ID (exact)</label><input id="search-source" data-help-key="logs.search-source" type="text" maxlength="256" placeholder="e.g. ho-b-adapter"></div>
                    <div class="filter-field-wide"><label for="search-since">From UTC (inclusive)</label><input id="search-since" data-help-key="logs.search-time" type="text" maxlength="32" placeholder="2026-11-04T10:00:00Z"></div>
                    <div class="filter-field-wide"><label for="search-until">Until UTC (inclusive)</label><input id="search-until" data-help-key="logs.search-time" type="text" maxlength="32" placeholder="2026-11-04T11:00:00Z"></div>
                    </div>
                    <div class="filter-actions" role="group" aria-label="Browse filters">
                        <button data-help-key="logs.apply-filters" type="submit" class="btn filter-apply">Apply filters</button>
