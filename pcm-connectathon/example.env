TEAM_ID=team-a
TEAM_RUNTIME_DIR=./teams/team-a
TEAM_CONFIG_HOST_PATH=./teams/team-a/team-config.json
TEAM_CONFIG_PATH=/runtime/team-config.json
TEAM_ADMIN_PASSWORD=change-me
LOCAL_UID=1000
LOCAL_GID=1000
PCM_CONFORMANCE_MODE=connectathon
PCM_OPERATIONAL_OAUTH_BASE=https://pcm2mtest.health.gov.il/api/fhir-service/r4
PCM_OPERATIONAL_FHIR_BASE=https://pcm2mtest.health.gov.il/api/fhir-service/r4
PCM_API_CLIENT_AUTH_MODE=mtls
PCM_ALLOW_ANY_TOKEN_RESOURCE=false
PCM_ACCESS_TOKEN_EXPIRES_IN_SECONDS=30
DS_GATEWAY_CLIENT_AUTH_MODE=mtls
SP_DS_VERIFY_SERVER_CERTIFICATE=false
DS_FHIR_UPSTREAM_PROTOCOL=https
DS_FHIR_UPSTREAM_VERIFY_SERVER_CERTIFICATE=false
DS_FHIR_UPSTREAM_CUSTOM_URL=
FHIR_SERVER_TLS=true

# Reference HMO imports use an 8 GiB HO-C heap and a 60-minute transaction wait.
# These are also the Compose defaults; nonempty per-target heap overrides replace them.
PCM_C_HAPI_JAVA_TOOL_OPTIONS=-Xmx8g
CLINICAL_DATA_TRANSACTION_WAIT_TIMEOUT_MS=3600000

SP_PORT=3100
PCM_UI_PORT=4100
PCM_API_PORT=4101
PCM_METADATA_PORT=4102
DS_GATEWAY_PORT=8180
DS_GATEWAY_HTTP_PORT=8183
HO_A_GATEWAY_PORT=8180
HO_B_GATEWAY_PORT=8181
HO_C_GATEWAY_PORT=8182

PCM_A_DB_PASSWORD=local-only-team-a-ho-a-db
PCM_B_DB_PASSWORD=local-only-team-a-ho-b-db
PCM_C_DB_PASSWORD=local-only-team-a-ho-c-db
PCM_A_DB_NAME=pcm_team_a_ho_a
PCM_B_DB_NAME=pcm_team_a_ho_b
PCM_C_DB_NAME=pcm_team_a_ho_c
PCM_A_DB_USER=pcm_team_a_a
PCM_B_DB_USER=pcm_team_a_b
PCM_C_DB_USER=pcm_team_a_c
PCM_A_IMPORT_CREDENTIAL=local-only-team-a-ho-a-import-0001
PCM_B_IMPORT_CREDENTIAL=local-only-team-a-ho-b-import-0001
PCM_C_IMPORT_CREDENTIAL=local-only-team-a-ho-c-import-0001

LOCAL_JWT_ISSUER=
LOCAL_JWT_SIGNING_KEY_PATH=/runtime/certs/ds-gateway.key
LOCAL_JWT_KEY_ID=
LOCAL_JWT_AUTHORIZATION_SERVER_METADATA_URL=http://ds-auth-adapter:3000/.well-known/oauth-authorization-server
LOCAL_JWT_AUDIENCE=
