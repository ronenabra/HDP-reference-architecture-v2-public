              "maximum": 300
            },
            "maxAttempts": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "maxResends": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "contactMaxAgeSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 31536000
