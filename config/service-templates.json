    {
      "key": "laboratory-follow-up",
      "summary": "Laboratory results and trends for a planned follow-up.",
      "dataDescription": "Observation. Recorded facts only; no diagnosis-specific or medication-name filter is inferred from this title.",
      "definition": {
        "name": "Laboratory result follow-up",
        "purpose": "Review laboratory results and trends across approved sources to support a planned follow-up visit for the selected patient.",
        "category": "35",
        "accessMode": "continuous",
        "duration": 3,
        "durationUnit": "mo",
        "allowChanges": true,
        "buckets": [
          {
            "code": "laboratoryTests",
            "history": 2,
            "historyUnit": "a",
            "sensitivity": []
          }
        ],
        "permissions": [
          {
            "type": "Patient",
            "actions": "rs"
          },
          {
            "type": "Observation",
            "actions": "rs"
          }
        ],
        "confidentialityPolicy": {
          "allowRestricted": false
        },
        "scopeOrigin": "generated"
      },
      "exampleQueries": [
        {
          "type": "Patient",
          "query": "GET [FHIR BASE]/Patient?_count=10"
        },
        {
          "type": "Observation",
          "query": "GET [FHIR BASE]/Observation?_count=10"
        }
      ]
    },
